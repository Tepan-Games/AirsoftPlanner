<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Génère la documentation PDF (logiciel Windows et application Android) avec des captures d'écran.
    Arguments : fichier .aop de démonstration, dossier des captures Android (produites par les tests
    d'interaction), fichier PDF à écrire.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
    <ProjectReference Include="..\..\src\AirsoftPlanner.App\AirsoftPlanner.App.csproj" />
  </ItemGroup>
</Project>
