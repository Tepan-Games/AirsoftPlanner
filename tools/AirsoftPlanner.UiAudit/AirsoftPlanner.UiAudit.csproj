<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Contrôle de mise en page : affiche chaque écran du logiciel (sans fenêtre visible) dans une langue et une taille
    de fenêtre données, et signale les boutons, cases et champs qui débordent de leur conteneur ou dont le texte est coupé.
    Arguments : fichier .aop, code de langue (fr, en, de, es, it), largeur, hauteur, [dossier des captures].
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
    <ProjectReference Include="..\..\src\AirsoftPlanner.App\AirsoftPlanner.App.csproj" />
  </ItemGroup>
</Project>
