<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests d'interaction entre l'application Android et le logiciel.
    Prérequis : émulateur Android démarré avec l'APK installé.
    Lancement : voir la section « Application Android » du README (argument : un fichier .aop).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
    <ProjectReference Include="..\..\src\AirsoftPlanner.App\AirsoftPlanner.App.csproj" />
  </ItemGroup>
</Project>
