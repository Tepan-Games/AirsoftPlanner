<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AirsoftPlanner.App.ViewModels"
             xmlns:conv="using:AirsoftPlanner.App.Converters"
             xmlns:controls="using:AirsoftPlanner.App.Controls"
             xmlns:views="using:AirsoftPlanner.App.Views"
             x:Class="AirsoftPlanner.App.Views.TrackingStatusPanel"
             x:DataType="vm:TrackingViewModel">
    <TabControl Grid.Row="2" Padding="0">
    <TabItem Header="Équipes">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="8,4">
            <WrapPanel>
                <ToggleButton Margin="0,0,8,4" Content="Placer l'équipe sur la carte" IsChecked="{Binding IsPlacing}"
                              IsEnabled="{Binding HasSelection}" />
                <TextBox Margin="0,0,8,4" Text="{Binding PositionInput}" Width="220" PlaceholderText="ou coordonnées reçues (UTM, degrés…)" />
                <Button Margin="0,0,8,4" Content="Enregistrer la position" Command="{Binding SetPositionCommand}" />
                <Button Margin="0,0,8,4" Content="Gérer le retard…" Command="{Binding PlanDelayCommand}"
                        ToolTip.Tip="Répercuter le retard estimé de l'équipe sur la suite du planning" />
                <Button Margin="0,0,8,4" Content="⚠ Mission urgente" Command="{Binding CreateUrgentMissionCommand}" Foreground="#C62828"
                        ToolTip.Tip="Crée tout de suite une mission pour l'équipe sélectionnée, puis cliquez sur la carte pour situer l'intervention" />
                <TextBlock Margin="0,0,8,4" Text="→ cliquez sur la carte" IsVisible="{Binding IsPlacingUrgent}" Foreground="#C62828"
                           VerticalAlignment="Center" FontWeight="SemiBold" />
            </WrapPanel>
        </Border>
        <ListBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Selected}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:TeamStatusViewModel">
                    <Grid ColumnDefinitions="Auto,150,*">
                        <Border Width="12" Height="12" CornerRadius="6" Margin="0,4,10,0" VerticalAlignment="Top"
                                Background="{Binding StatusColor, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Team.Name}" FontWeight="SemiBold" />
                            <TextBlock FontSize="11" FontFamily="Consolas,monospace" Text="{Binding Team.RadioFrequencyLabel}" />
                            <TextBlock Text="{Binding StatusLabel}" FontSize="11"
                                       Foreground="{Binding StatusColor, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                            <TextBlock Text="{Binding StrengthText}" FontSize="11" FontWeight="SemiBold"
                                       Classes.warning="{Binding HasRealInjury}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding MissionText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding DistanceText}" FontSize="11" Opacity="0.8" />
                            <TextBlock Text="{Binding PositionText}" FontSize="11" Opacity="0.6" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
    </TabItem>
    <TabItem Header="Joueurs">
        <DockPanel Margin="8,4">
            <TextBlock DockPanel.Dock="Top" IsVisible="{Binding !HasSelection}" Opacity="0.65"
                       Text="Sélectionnez une équipe dans l'onglet Équipes." />
            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="11" Opacity="0.8" Margin="0,0,0,4">
                <Run Text="{Binding Selected.Team.Name, FallbackValue=''}" FontWeight="SemiBold" />
                <Run Text="— " />
                <Run Text="{Binding StrengthHistory}" />
            </TextBlock>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <ComboBox ItemsSource="{Binding OutReasons}" SelectedItem="{Binding SelectedOutReason}" MinWidth="170" Margin="0,0,6,4" />
                <TextBox Text="{Binding OutNotes}" Width="160" PlaceholderText="Précision (facultatif)" Margin="0,0,6,4" />
                <NumericUpDown Value="{Binding AnonymousCount}" Minimum="1" Maximum="100" Increment="1" FormatString="0" Width="110"
                               IsVisible="{Binding !SelectedTeamHasMembers}" Margin="0,0,6,4"
                               ToolTip.Tip="Nombre de joueurs (équipe sans membres saisis)" />
                <Button Content="Hors jeu" Command="{Binding PlayerOutCommand}" Margin="0,0,6,4" />
                <Button Content="Retour en jeu" Command="{Binding PlayerBackCommand}" Margin="0,0,6,4" />
            </WrapPanel>
            <ListBox ItemsSource="{Binding Players}" SelectedItem="{Binding SelectedPlayer}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlayerRow">
                        <Grid ColumnDefinitions="220,*">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding StateText}" Classes.warning="{Binding IsOut}" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </TabItem>
    <TabItem Header="Messages et missions">
        <ScrollViewer DataContext="{Binding Dispatch}" x:DataType="vm:DispatchViewModel">
            <StackPanel Margin="8,4" Spacing="6">
                <TextBlock Text="Message aux téléphones des équipes" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <RadioButton Content="QG (ordre en jeu)" IsChecked="{Binding ComposeAsHq}" GroupName="sender"
                                 ToolTip.Tip="Affiché dans la partie principale de l'application, comme un ordre du commandement (roleplay)" />
                    <RadioButton Content="Orga (organisation, sécurité)" IsChecked="{Binding !ComposeAsHq}" GroupName="sender"
                                 ToolTip.Tip="Affiché dans la section Orga de l'application, avec les contacts de l'orga" />
                </StackPanel>
                <DockPanel>
                    <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" MinWidth="190" Margin="0,0,6,0" />
                    <Button DockPanel.Dock="Right" Content="Envoyer" Command="{Binding SendCommand}" Margin="6,0,0,0" Classes="accent" />
                    <TextBox Text="{Binding ComposeText}" PlaceholderText="ex. Fin de partie à 17 h, retour au PC" AcceptsReturn="False" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MessageRowViewModel">
                            <StackPanel Margin="0,3">
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="{Binding Time}" FontWeight="SemiBold" />
                                    <Run Text="{Binding Sender}" FontWeight="SemiBold" />
                                    <Run Text="→" Foreground="Gray" />
                                    <Run Text="{Binding Audience}" Foreground="Gray" />
                                    <Run Text="  " />
                                    <Run Text="{Binding Text}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Delivery}" FontSize="11" Opacity="0.7" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Missions diffusées aux téléphones" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                           Text="Le téléphone affiche seulement la mission diffusée par l'orga. Le bandeau « À diffuser » propose de terminer une mission ou de diffuser la suivante au bon moment ; ici, on peut diffuser n'importe quelle mission." />
                <ItemsControl ItemsSource="{Binding Teams}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TeamDispatchViewModel">
                            <Grid ColumnDefinitions="110,*,Auto,Auto,Auto" Margin="0,2">
                                <TextBlock Text="{Binding Team.Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding Published}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                                <ComboBox Grid.Column="2" ItemsSource="{Binding Missions}" SelectedItem="{Binding SelectedMission}" Width="190" Margin="0,0,4,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MissionViewModel">
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="3" Content="Diffuser" Margin="0,0,4,0"
                                        Command="{Binding $parent[ItemsControl].((vm:DispatchViewModel)DataContext).PublishSelectedCommand}"
                                        CommandParameter="{Binding}" />
                                <Button Grid.Column="4" Content="Terminer"
                                        Command="{Binding $parent[ItemsControl].((vm:DispatchViewModel)DataContext).EndPublishedCommand}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </TabItem>
    <TabItem Header="Réception GPS">
        <ScrollViewer DataContext="{Binding Gps}" x:DataType="vm:GpsViewModel">
            <StackPanel Margin="8,4" Spacing="6">
                <TextBlock Text="Smartphones sur le réseau local (Traccar Client, OsmAnd…)" FontWeight="SemiBold" />
                <WrapPanel>
                    <TextBlock Text="Port" VerticalAlignment="Center" Margin="0,0,6,4" />
                    <NumericUpDown Value="{Binding ServerPort}" Minimum="1024" Maximum="65535" FormatString="0" Width="120" Margin="0,0,8,4" />
                    <ToggleButton Content="Serveur actif" IsChecked="{Binding IsServerRunning, Mode=OneWay}"
                                  Command="{Binding ToggleServerCommand}" Margin="0,0,8,4" />
                    <CheckBox Content="Au lancement" IsChecked="{Binding AutoStartServer}" Margin="0,0,8,4"
                              ToolTip.Tip="Démarrer le serveur dès l'ouverture d'une OP sur ce PC" />
                    <SelectableTextBlock Text="{Binding ServerAddresses}" VerticalAlignment="Center" FontFamily="Consolas,monospace" />
                </WrapPanel>
                <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                           Text="Dans Traccar Client : adresse du serveur = une adresse ci-dessus (même Wi-Fi que ce PC), identifiant de l'appareil = un identifiant GPS de l'équipe (onglet Équipes). Sans application : ouvrir l'adresse suivie de /saisie dans le navigateur du téléphone pour taper les coordonnées. Autres PC : /api/positions. Autorisez le logiciel dans le pare-feu Windows au premier démarrage." />
                <TextBlock Text="Second poste : suivre l'OP menée sur un autre PC" FontWeight="SemiBold" Margin="0,6,0,0" />
                <WrapPanel>
                    <TextBox Text="{Binding UpstreamUrl}" Width="240" PlaceholderText="http://192.168.1.20:5055" Margin="0,0,6,4" />
                    <ToggleButton Content="Connecté" IsChecked="{Binding IsUpstreamConnected, Mode=OneWay}"
                                  Command="{Binding ToggleUpstreamCommand}" Margin="0,0,6,4"
                                  ToolTip.Tip="Récupère toutes les 10 s les positions collectées par le PC de l'OP (son serveur doit être actif)" />
                </WrapPanel>

                <TextBlock Text="Application Android (enrôlement par code d'équipe)" FontWeight="SemiBold" Margin="0,6,0,0" />
                <WrapPanel>
                    <ComboBox ItemsSource="{Binding Teams}" SelectedItem="{Binding EnrollmentTeam}" MinWidth="160" PlaceholderText="Équipe…" Margin="0,0,6,4">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TeamViewModel">
                                <TextBlock>
                                    <Run Text="{Binding Name}" />
                                    <Run Text="{Binding EnrollmentCodeText}" FontFamily="Consolas,monospace" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Nouveau code" Command="{Binding GenerateCodeCommand}" Margin="0,0,6,4" />
                    <Button Content="QR code…" Command="{Binding ShowQrCodeCommand}" Margin="0,0,6,4" />
                    <TextBlock Text="Envoi toutes les" VerticalAlignment="Center" Margin="8,0,6,4" />
                    <NumericUpDown Value="{Binding IntervalSeconds}" Minimum="5" Maximum="3600" Increment="5" FormatString="0" Width="110" Margin="0,0,6,4" />
                    <TextBlock Text="s" VerticalAlignment="Center" Margin="0,0,6,4" />
                </WrapPanel>
                <WrapPanel>
                    <TextBlock Text="Les téléphones voient :" VerticalAlignment="Center" Margin="0,0,6,4" />
                    <ComboBox ItemsSource="{Binding ShareModes}" SelectedItem="{Binding ShareMode}" MinWidth="280" Margin="0,0,6,4"
                              ToolTip.Tip="Positions des équipes alliées (même faction) renvoyées à l'application, avec le récap de leur mission" />
                </WrapPanel>
                <WrapPanel>
                    <TextBlock Text="Adresse publiée" VerticalAlignment="Center" Margin="0,0,6,4" />
                    <TextBox Text="{Binding ServerAddress}" Width="240" PlaceholderText="IP du PC (ou monop.duckdns.org)" Margin="0,0,6,4"
                             ToolTip.Tip="Nom DynDNS (ou adresse fixe) imprimé dans les packages et les QR codes. Vide : adresse IP actuelle de ce PC." />
                    <TextBox Text="{Binding DynDnsUpdateUrl}" Width="320" Margin="0,0,6,4" PasswordChar="•" RevealPassword="{Binding #RevealDynDns.IsChecked}"
                             PlaceholderText="Adresse de mise à jour DynDNS, avec {ip}"
                             ToolTip.Tip="Ex. DuckDNS : https://www.duckdns.org/update?domains=monop&amp;token=VOTRE-JETON&amp;ip={ip} — mise à jour au démarrage du serveur puis dès que l'IP du PC change (vérifiée toutes les 5 min). Réglage de ce PC, jeton chiffré." />
                    <CheckBox Name="RevealDynDns" Content="Afficher" Margin="0,0,6,4" />
                    <Button Content="Mettre à jour" Command="{Binding UpdateDynDnsCommand}" Margin="0,0,6,4" />
                </WrapPanel>
                <TextBlock Text="{Binding DynDnsStatus}" IsVisible="{Binding DynDnsStatus.Length}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                           Text="Si l'adresse du PC a changé (autre box, IP différente, pas d'Internet sur le terrain), l'application retrouve seule ce PC sur le Wi-Fi. Le nom DynDNS reçoit l'IP locale du PC : il sert quand le terrain a Internet (certaines box bloquent ces noms : la recherche sur le Wi-Fi prend alors le relais)." />
                <WrapPanel IsVisible="{Binding Devices.Count}">
                    <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" MinWidth="320" Margin="0,0,6,4" PlaceholderText="Téléphones enrôlés…">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:EnrolledDeviceRow">
                                <TextBlock>
                                    <Run Text="{Binding Team}" FontWeight="SemiBold" />
                                    <Run Text="{Binding Device}" />
                                    <Run Text="{Binding LastSeen}" Foreground="Gray" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Révoquer" Command="{Binding RevokeDeviceCommand}" Margin="0,0,6,4"
                            ToolTip.Tip="Le téléphone ne pourra plus envoyer de positions (perdu, prêté...)" />
                </WrapPanel>

                <TextBlock Text="Meshtastic (passerelle MQTT, messages JSON)" FontWeight="SemiBold" Margin="0,6,0,0" />
                <WrapPanel>
                    <TextBox Text="{Binding MqttHost}" Width="150" PlaceholderText="Broker (ex. localhost)" Margin="0,0,6,4" />
                    <NumericUpDown Value="{Binding MqttPort}" Minimum="1" Maximum="65535" FormatString="0" Width="110" Margin="0,0,6,4" />
                    <TextBox Text="{Binding MqttTopic}" Width="120" PlaceholderText="msh/#" Margin="0,0,6,4" />
                    <TextBox Text="{Binding MqttUser}" Width="110" PlaceholderText="Utilisateur" Margin="0,0,6,4" />
                    <TextBox Text="{Binding MqttPassword}" Width="110" PasswordChar="•" PlaceholderText="Mot de passe" Margin="0,0,6,4" />
                    <ToggleButton Content="Connecté" IsChecked="{Binding IsMeshtasticConnected, Mode=OneWay}"
                                  Command="{Binding ToggleMeshtasticCommand}" Margin="0,0,6,4" />
                </WrapPanel>

                <TextBlock Text="Serveur Traccar (webservice)" FontWeight="SemiBold" Margin="0,6,0,0" />
                <WrapPanel>
                    <TextBox Text="{Binding TraccarUrl}" Width="220" PlaceholderText="https://traccar.exemple.fr" Margin="0,0,6,4" />
                    <TextBox Text="{Binding TraccarUser}" Width="150" PlaceholderText="E-mail (vide = jeton)" Margin="0,0,6,4" />
                    <TextBox Text="{Binding TraccarPassword}" Width="130" PasswordChar="•" PlaceholderText="Mot de passe / jeton" Margin="0,0,6,4" />
                    <ToggleButton Content="Connecté" IsChecked="{Binding IsTraccarConnected, Mode=OneWay}"
                                  Command="{Binding ToggleTraccarCommand}" Margin="0,0,6,4" />
                </WrapPanel>

                <WrapPanel Margin="0,6,0,0">
                    <Button Content="Importer une trace GPX / un CSV…" Command="{Binding ImportFileCommand}" Margin="0,0,6,4"
                            ToolTip.Tip="GPX : attribué à l'équipe sélectionnée. CSV : colonnes Équipe (ou Appareil), Latitude, Longitude, Heure" />
                </WrapPanel>

                <TextBlock Text="Appareils inconnus" FontWeight="SemiBold" Margin="0,6,0,0"
                           IsVisible="{Binding UnknownDevices.Count}" />
                <WrapPanel IsVisible="{Binding UnknownDevices.Count}">
                    <ComboBox ItemsSource="{Binding UnknownDevices}" SelectedItem="{Binding SelectedUnknownDevice}" MinWidth="220" Margin="0,0,6,4">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:UnknownDevice">
                                <TextBlock>
                                    <Run Text="{Binding DeviceId}" FontWeight="SemiBold" />
                                    <Run Text="{Binding Source}" />
                                    <Run Text="{Binding LastSeen}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Associer à l'équipe sélectionnée" Command="{Binding AssignDeviceCommand}" Margin="0,0,6,4" />
                </WrapPanel>

                <TextBlock Text="Journal" FontWeight="SemiBold" Margin="0,6,0,0" />
                <ItemsControl ItemsSource="{Binding Journal}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" FontSize="11" FontFamily="Consolas,monospace" Opacity="0.8" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </TabItem>
    <TabItem Header="Objets d'objectif">
        <DockPanel>
            <Border DockPanel.Dock="Top" Padding="8,4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox ItemsSource="{Binding ItemEventOptions}" SelectedItem="{Binding SelectedItemEvent}" MinWidth="170" />
                    <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding ItemEventTeam}" MinWidth="140"
                              IsVisible="{Binding ItemEventNeedsTeam}" PlaceholderText="Équipe…">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TeamStatusViewModel">
                                <TextBlock Text="{Binding Team.Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Enregistrer" Command="{Binding RecordItemEventCommand}"
                            ToolTip.Tip="« Placé » et « Déposé » demandent ensuite un clic sur la carte" />
                    <TextBlock Text="→ cliquez sur la carte" IsVisible="{Binding IsPlacingItem}" Foreground="#EF6C00"
                               VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <TextBlock DockPanel.Dock="Top" IsVisible="{Binding !TrackedItems.Count}" Margin="10" Opacity="0.65" TextWrapping="Wrap"
                       Text="Aucun objet suivi : cochez « Objet d'objectif à suivre » sur les éléments concernés dans l'onglet Matériel de jeu." />
            <ListBox ItemsSource="{Binding TrackedItems}" SelectedItem="{Binding SelectedItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:TrackedItemViewModel">
                        <Grid ColumnDefinitions="Auto,200,*">
                            <Border Width="12" Height="12" CornerRadius="2" Margin="0,4,10,0" VerticalAlignment="Top"
                                    Background="{Binding StateColor, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Item.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding StateText}" FontSize="11"
                                           Foreground="{Binding StateColor, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding LocationText}" FontSize="11" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding History}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{Binding}" FontSize="11" Opacity="0.65" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </TabItem>
    </TabControl>
</UserControl>
