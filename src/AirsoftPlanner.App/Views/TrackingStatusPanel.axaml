<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:l="using:AirsoftPlanner.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AirsoftPlanner.App.ViewModels"
             xmlns:planning="using:AirsoftPlanner.Core.Planning"
             xmlns:conv="using:AirsoftPlanner.App.Converters"
             xmlns:controls="using:AirsoftPlanner.App.Controls"
             xmlns:views="using:AirsoftPlanner.App.Views"
             x:Class="AirsoftPlanner.App.Views.TrackingStatusPanel"
             x:DataType="vm:TrackingViewModel">
    <TabControl Grid.Row="2" Padding="0">
    <TabItem Header="{l:T equipes}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="8,4">
            <WrapPanel>
                <ToggleButton Margin="0,0,8,4" Content="{l:T placer_l_equipe_sur_la_carte}" IsChecked="{Binding IsPlacing}"
                              IsEnabled="{Binding HasSelection}" />
                <TextBox Margin="0,0,8,4" Text="{Binding PositionInput}" Width="220" PlaceholderText="{l:T ou_coordonnees_recues_utm_degres}" />
                <Button Margin="0,0,8,4" Content="{l:T enregistrer_la_position}" Command="{Binding SetPositionCommand}" />
                <Button Margin="0,0,8,4" Content="{l:T gerer_le_retard}" Command="{Binding PlanDelayCommand}"
                        ToolTip.Tip="{l:T repercuter_le_retard_estime_de_l_equipe_sur_la_s}" />
                <Button Margin="0,0,8,4" Content="{l:T mission_urgente}" Command="{Binding CreateUrgentMissionCommand}" Foreground="#C62828"
                        ToolTip.Tip="{l:T cree_tout_de_suite_une_mission_pour_l_equipe_sel}" />
                <TextBlock Margin="0,0,8,4" Text="{l:T cliquez_sur_la_carte}" IsVisible="{Binding IsPlacingUrgent}" Foreground="#C62828"
                           VerticalAlignment="Center" FontWeight="SemiBold" />
            </WrapPanel>
        </Border>
        <ListBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Selected}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:TeamStatusViewModel">
                    <Grid ColumnDefinitions="Auto,150,*">
                        <Border Width="12" Height="12" CornerRadius="6" Margin="0,4,10,0" VerticalAlignment="Top"
                                Background="{Binding StatusColor, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Team.Name}" FontWeight="SemiBold" />
                            <TextBlock FontSize="11" FontFamily="Consolas,monospace" Text="{Binding Team.RadioFrequencyLabel}" />
                            <TextBlock Text="{Binding StatusLabel}" FontSize="11"
                                       Foreground="{Binding StatusColor, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                            <TextBlock Text="{Binding StrengthText}" FontSize="11" FontWeight="SemiBold"
                                       Classes.warning="{Binding HasRealInjury}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding MissionText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding DistanceText}" FontSize="11" Opacity="0.8" />
                            <TextBlock Text="{Binding PositionText}" FontSize="11" Opacity="0.6" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
    </TabItem>
    <TabItem Header="{l:T joueurs}">
        <DockPanel Margin="8,4">
            <TextBlock DockPanel.Dock="Top" IsVisible="{Binding !HasSelection}" Opacity="0.65"
                       Text="{l:T selectionnez_une_equipe_dans_l_onglet_equipes}" />
            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="11" Opacity="0.8" Margin="0,0,0,4">
                <Run Text="{Binding Selected.Team.Name, FallbackValue=''}" FontWeight="SemiBold" />
                <Run Text="— " />
                <Run Text="{Binding StrengthHistory}" />
            </TextBlock>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <ComboBox ItemsSource="{Binding OutReasons}" SelectedItem="{Binding SelectedOutReason}" MinWidth="170" Margin="0,0,6,4" />
                <TextBox Text="{Binding OutNotes}" Width="160" PlaceholderText="{l:T precision_facultatif}" Margin="0,0,6,4" />
                <NumericUpDown Value="{Binding AnonymousCount}" Minimum="1" Maximum="100" Increment="1" FormatString="0" Width="110"
                               IsVisible="{Binding !SelectedTeamHasMembers}" Margin="0,0,6,4"
                               ToolTip.Tip="{l:T nombre_de_joueurs_equipe_sans_membres_saisis}" />
                <Button Content="{l:T hors_jeu}" Command="{Binding PlayerOutCommand}" Margin="0,0,6,4" />
                <Button Content="{l:T retour_en_jeu}" Command="{Binding PlayerBackCommand}" Margin="0,0,6,4" />
            </WrapPanel>
            <ListBox ItemsSource="{Binding Players}" SelectedItem="{Binding SelectedPlayer}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlayerRow">
                        <Grid ColumnDefinitions="220,*">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding StateText}" Classes.warning="{Binding IsOut}" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </TabItem>
    <TabItem Header="{l:T messages_et_missions}">
        <ScrollViewer DataContext="{Binding Dispatch}" x:DataType="vm:DispatchViewModel">
            <StackPanel Margin="8,4" Spacing="6">
                <TextBlock Text="{l:T message_aux_telephones_des_equipes}" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <RadioButton Content="{l:T qg_ordre_en_jeu}" IsChecked="{Binding ComposeAsHq}" GroupName="sender"
                                 ToolTip.Tip="{l:T affiche_dans_la_partie_principale_de_l_applicati}" />
                    <RadioButton Content="{l:T orga_organisation_securite}" IsChecked="{Binding !ComposeAsHq}" GroupName="sender"
                                 ToolTip.Tip="{l:T affiche_dans_la_section_orga_de_l_application_av}" />
                </StackPanel>
                <DockPanel>
                    <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" MinWidth="190" Margin="0,0,6,0" />
                    <Button DockPanel.Dock="Right" Content="{l:T envoyer}" Command="{Binding SendCommand}" Margin="6,0,0,0" Classes="accent" />
                    <Button DockPanel.Dock="Right" Content="{l:T photo}" Command="{Binding AttachPhotoCommand}" Margin="6,0,0,0"
                            ToolTip.Tip="{l:T joindre_une_photo_reduite_automatiquement_pour_l}" />
                    <TextBox Text="{Binding ComposeText}" PlaceholderText="{l:T ex_fin_de_partie_a_17_h_retour_au_pc}" AcceptsReturn="False" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasComposePhoto}">
                    <TextBlock Text="{l:T photo_jointe_au_prochain_message}" VerticalAlignment="Center" FontSize="12" />
                    <Button Content="✕" Classes="icon" ToolTip.Tip="{l:T retirer}" AutomationProperties.Name="{l:T retirer}" Command="{Binding RemovePhotoCommand}" Padding="6,1" FontSize="11" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MessageRowViewModel">
                            <StackPanel Margin="0,3">
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="{Binding Time}" FontWeight="SemiBold" />
                                    <Run Text="{Binding Sender}" FontWeight="SemiBold" />
                                    <Run Text="→" Foreground="Gray" />
                                    <Run Text="{Binding Audience}" Foreground="Gray" />
                                    <Run Text="  " />
                                    <Run Text="{Binding Text}" />
                                </TextBlock>
                                <Image Source="{Binding Thumbnail}" IsVisible="{Binding HasPhoto}" MaxWidth="160" MaxHeight="120"
                                       HorizontalAlignment="Left" Margin="0,2" />
                                <TextBlock Text="{Binding Delivery}" FontSize="11" Opacity="0.7" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <DockPanel Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Content="✓" Classes="icon" Command="{Binding MarkReportsReadCommand}"
                            IsVisible="{Binding HasUnreadReports}" ToolTip.Tip="{l:T marquer_comme_lus}" AutomationProperties.Name="{l:T marquer_comme_lus}" />
                    <TextBlock Text="{l:T messages_recus_des_telephones}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{l:T aucun_message_recu}" IsVisible="{Binding !Reports.Count}" FontSize="12" Opacity="0.6" />
                <ItemsControl ItemsSource="{Binding Reports}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ReportRowViewModel">
                            <Grid ColumnDefinitions="Auto,*" Margin="0,3">
                                <Button Grid.Column="0" IsVisible="{Binding HasPhoto}" Padding="0" Margin="0,0,8,0" Background="Transparent"
                                        Command="{Binding $parent[ItemsControl].((vm:DispatchViewModel)DataContext).ShowReportPhotoCommand}" CommandParameter="{Binding}"
                                        ToolTip.Tip="{l:T agrandir_la_photo}">
                                    <Image Source="{Binding Thumbnail}" Width="80" />
                                </Button>
                                <StackPanel Grid.Column="1">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="{Binding Time}" FontWeight="SemiBold" />
                                        <Run Text="{Binding Author}" FontWeight="SemiBold" Foreground="#1565C0" />
                                        <Run Text="{Binding Recipient}" Foreground="Gray" />
                                        <Run Text="{Binding Text}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Position}" IsVisible="{Binding HasPosition}" FontSize="11" Opacity="0.7" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{l:T missions_diffusees_aux_telephones}" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                           Text="{l:T le_telephone_affiche_seulement_la_mission_diffus}" />
                <ItemsControl ItemsSource="{Binding Teams}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TeamDispatchViewModel">
                            <Grid ColumnDefinitions="110,*,Auto,Auto,Auto,Auto,Auto" Margin="0,2">
                                <TextBlock Text="{Binding Team.Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding Published}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                                <ComboBox Grid.Column="4" ItemsSource="{x:Static vm:MissionResultOption.All}" SelectedItem="{Binding Current.Result, FallbackValue={x:Null}}"
                                          IsVisible="{Binding HasCurrent}" Width="130" Margin="4,0,4,0" ToolTip.Tip="{l:T resultat_de_la_mission_terminee}" />
                                <CheckBox Grid.Column="5" Content="📣" IsChecked="{Binding AnnounceResult}" AutomationProperties.Name="{l:T annoncer}"
                                          IsVisible="{Binding Current.IsEvaluated, FallbackValue=False}" ToolTip.Tip="{l:T annoncer_aide}" />
                                <ComboBox Grid.Column="2" ItemsSource="{Binding Missions}" SelectedItem="{Binding SelectedMission}" Width="190" Margin="0,0,4,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MissionViewModel">
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="3" Content="📤" Classes="icon" ToolTip.Tip="{l:T diffuser}" AutomationProperties.Name="{l:T diffuser}" Margin="0,0,4,0"
                                        Command="{Binding $parent[ItemsControl].((vm:DispatchViewModel)DataContext).PublishSelectedCommand}"
                                        CommandParameter="{Binding}" />
                                <Button Grid.Column="6" Content="⏹" Classes="icon" ToolTip.Tip="{l:T terminer}" AutomationProperties.Name="{l:T terminer}"
                                        Command="{Binding $parent[ItemsControl].((vm:DispatchViewModel)DataContext).EndPublishedCommand}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </TabItem>
    <TabItem Header="{l:T score}">
        <ScrollViewer DataContext="{Binding Dispatch}" x:DataType="vm:DispatchViewModel">
            <StackPanel Margin="8" Spacing="4">
                <TextBlock Text="{Binding ScoreSummary}" FontSize="11" Opacity="0.7" />
                <TextBlock Text="{l:T score_par_faction}" FontWeight="SemiBold" Margin="0,4,0,0" />
                <ItemsControl ItemsSource="{Binding FactionScores}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="planning:ScoreLine">
                            <Grid ColumnDefinitions="14,*,70,Auto" Margin="0,2">
                                <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                                        Background="{Binding Color, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Points, StringFormat={}{0} pts}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.75">
                                    <Run Text="✔" /><Run Text="{Binding Success}" />
                                    <Run Text="  ◐" /><Run Text="{Binding Partial}" />
                                    <Run Text="  ✘" /><Run Text="{Binding Failure}" />
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{l:T score_par_equipe}" FontWeight="SemiBold" Margin="0,8,0,0" />
                <ItemsControl ItemsSource="{Binding TeamScores}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="planning:ScoreLine">
                            <Grid ColumnDefinitions="14,*,70,Auto" Margin="0,2">
                                <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                                        Background="{Binding Color, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Points, StringFormat={}{0} pts}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.75">
                                    <Run Text="✔" /><Run Text="{Binding Success}" />
                                    <Run Text="  ◐" /><Run Text="{Binding Partial}" />
                                    <Run Text="  ✘" /><Run Text="{Binding Failure}" />
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{l:T score_aide}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>
    </TabItem>
    <TabItem Header="{l:T objets_d_objectif}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Padding="8,4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox ItemsSource="{Binding ItemEventOptions}" SelectedItem="{Binding SelectedItemEvent}" MinWidth="170" />
                    <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding ItemEventTeam}" MinWidth="140"
                              IsVisible="{Binding ItemEventNeedsTeam}" PlaceholderText="{l:T equipe_2}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TeamStatusViewModel">
                                <TextBlock Text="{Binding Team.Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="{l:T enregistrer}" Command="{Binding RecordItemEventCommand}"
                            ToolTip.Tip="{l:T place_et_depose_demandent_ensuite_un_clic_sur_la}" />
                    <TextBlock Text="{l:T cliquez_sur_la_carte}" IsVisible="{Binding IsPlacingItem}" Foreground="#EF6C00"
                               VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <TextBlock DockPanel.Dock="Top" IsVisible="{Binding !TrackedItems.Count}" Margin="10" Opacity="0.65" TextWrapping="Wrap"
                       Text="{l:T aucun_objet_suivi_cochez_objet_d_objectif_a_suiv}" />
            <ListBox ItemsSource="{Binding TrackedItems}" SelectedItem="{Binding SelectedItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:TrackedItemViewModel">
                        <Grid ColumnDefinitions="Auto,200,*">
                            <Border Width="12" Height="12" CornerRadius="2" Margin="0,4,10,0" VerticalAlignment="Top"
                                    Background="{Binding StateColor, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Item.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding StateText}" FontSize="11"
                                           Foreground="{Binding StateColor, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding LocationText}" FontSize="11" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding History}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{Binding}" FontSize="11" Opacity="0.65" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </TabItem>
    </TabControl>
</UserControl>
