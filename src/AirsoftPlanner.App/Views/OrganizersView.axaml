<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:l="using:AirsoftPlanner.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AirsoftPlanner.App.ViewModels"
             x:Class="AirsoftPlanner.App.Views.OrganizersView"
             x:DataType="vm:OrganizersViewModel">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,12">
            <TextBlock Text="{l:T organisation}" Classes="h1" />
            <TextBlock>
                <Run Text="{Binding General.OrganizerName}" FontWeight="SemiBold" />
                <Run Text="  📻 " />
                <Run Text="{Binding General.OrgaRadioFrequency}" />
                <Run Text="  ☎ " />
                <Run Text="{Binding General.EmergencyPhone}" />
            </TextBlock>
            <TextBlock Text="{l:T nom_de_l_organisation_frequence_et_numero_d_urge}" FontSize="11" Opacity="0.7" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" DataContext="{Binding Gps}" x:DataType="vm:GpsViewModel" Spacing="6" Margin="0,12,0,0">
            <TextBlock Classes="h2" Text="{l:T telephone_de_l_orga_selectionne}" />
            <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                       Text="{l:T enrole_avec_ce_code_le_telephone_d_un_orga_envoi}" />
            <WrapPanel>
                <TextBlock VerticalAlignment="Center" Margin="0,0,12,4">
                    <Run Text="{Binding EnrollmentOrganizer.Name, FallbackValue={l:T selectionnez_un_orga}}" FontWeight="SemiBold" />
                    <Run Text="{l:T code}" />
                    <Run Text="{Binding EnrollmentOrganizer.EnrollmentCodeText, FallbackValue='—'}" FontFamily="Consolas,monospace" FontWeight="Bold" FontSize="15" />
                </TextBlock>
                <Button Content="{l:T nouveau_code}" Command="{Binding GenerateOrganizerCodeCommand}" Margin="0,0,6,4" />
                <Button Content="{l:T qr_code}" Command="{Binding ShowOrganizerQrCodeCommand}" Margin="0,0,6,4" />
            </WrapPanel>
            <ItemsControl ItemsSource="{Binding OrganizerDevices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:EnrolledDeviceRow">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="📱" />
                                <Run Text="{Binding Device}" FontWeight="SemiBold" />
                                <Run Text="{Binding LastSeen}" Foreground="Gray" />
                            </TextBlock>
                            <Button Content="{l:T revoquer}" Padding="6,1" FontSize="11" IsVisible="{Binding !IsRevoked}"
                                    Command="{Binding $parent[ItemsControl].((vm:GpsViewModel)DataContext).RevokeRowCommand}" CommandParameter="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Content="{l:T orga}" Command="{Binding AddCommand}" />
            <Button Content="✕" Classes="icon" ToolTip.Tip="{l:T retirer}" AutomationProperties.Name="{l:T retirer}" Command="{Binding RemoveCommand}" />
        </StackPanel>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False" CanUserSortColumns="True" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" BorderThickness="1"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{l:T nom}" Binding="{Binding Name}" Width="1.2*" />
                <DataGridTextColumn Header="{l:T role_directeur_de_jeu_arbitre_secours}" Binding="{Binding Role}" Width="1.4*" />
                <DataGridTextColumn Header="{l:T telephone}" Binding="{Binding Phone}" Width="*" />
                <DataGridTextColumn Header="{l:T radio}" Binding="{Binding RadioFrequency}" Width="*" />
                <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="1.4*" />
                <DataGridTextColumn Header="{l:T code_telephone}" Binding="{Binding EnrollmentCodeText}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="{l:T remarques}" Binding="{Binding Notes}" Width="1.4*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
