<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AirsoftPlanner.App.ViewModels"
             x:Class="AirsoftPlanner.App.Views.OrganizersView"
             x:DataType="vm:OrganizersViewModel">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,12">
            <TextBlock Text="Organisation" Classes="h1" />
            <TextBlock>
                <Run Text="{Binding General.OrganizerName}" FontWeight="SemiBold" />
                <Run Text="  📻 " />
                <Run Text="{Binding General.OrgaRadioFrequency}" />
                <Run Text="  ☎ " />
                <Run Text="{Binding General.EmergencyPhone}" />
            </TextBlock>
            <TextBlock Text="Nom de l'organisation, fréquence et numéro d'urgence communs : onglet Général." FontSize="11" Opacity="0.7" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" DataContext="{Binding Gps}" x:DataType="vm:GpsViewModel" Spacing="6" Margin="0,12,0,0">
            <TextBlock Classes="h2" Text="Téléphone de l'orga sélectionné" />
            <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                       Text="Enrôlé avec ce code, le téléphone d'un orga envoie sa position (visible sur la carte du suivi) et affiche toutes les équipes et tous les points." />
            <WrapPanel>
                <TextBlock VerticalAlignment="Center" Margin="0,0,12,4">
                    <Run Text="{Binding EnrollmentOrganizer.Name, FallbackValue='Sélectionnez un orga'}" FontWeight="SemiBold" />
                    <Run Text="  code :" />
                    <Run Text="{Binding EnrollmentOrganizer.EnrollmentCodeText, FallbackValue='—'}" FontFamily="Consolas,monospace" FontWeight="Bold" FontSize="15" />
                </TextBlock>
                <Button Content="Nouveau code" Command="{Binding GenerateOrganizerCodeCommand}" Margin="0,0,6,4" />
                <Button Content="QR code…" Command="{Binding ShowOrganizerQrCodeCommand}" Margin="0,0,6,4" />
            </WrapPanel>
            <ItemsControl ItemsSource="{Binding OrganizerDevices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:EnrolledDeviceRow">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="📱" />
                                <Run Text="{Binding Device}" FontWeight="SemiBold" />
                                <Run Text="{Binding LastSeen}" Foreground="Gray" />
                            </TextBlock>
                            <Button Content="Révoquer" Padding="6,1" FontSize="11" IsVisible="{Binding !IsRevoked}"
                                    Command="{Binding $parent[ItemsControl].((vm:GpsViewModel)DataContext).RevokeRowCommand}" CommandParameter="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Content="+ Orga" Command="{Binding AddCommand}" />
            <Button Content="Retirer" Command="{Binding RemoveCommand}" />
        </StackPanel>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False" CanUserSortColumns="True" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" BorderThickness="1"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="1.2*" />
                <DataGridTextColumn Header="Rôle (directeur de jeu, arbitre, secours…)" Binding="{Binding Role}" Width="1.4*" />
                <DataGridTextColumn Header="Téléphone" Binding="{Binding Phone}" Width="*" />
                <DataGridTextColumn Header="Radio" Binding="{Binding RadioFrequency}" Width="*" />
                <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="1.4*" />
                <DataGridTextColumn Header="Code téléphone" Binding="{Binding EnrollmentCodeText}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="Remarques" Binding="{Binding Notes}" Width="1.4*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
