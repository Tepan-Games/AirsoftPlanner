<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AirsoftPlanner.App.ViewModels"
        xmlns:views="using:AirsoftPlanner.App.Views"
        xmlns:radio="using:AirsoftPlanner.Core.Radio"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="AirsoftPlanner.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/airsoftplanner.ico"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        Title="{Binding WindowTitle}">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewOperationCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenOperationCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+T" Command="{Binding ToggleThemeCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="12,8" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Coordonnées :" VerticalAlignment="Center" Opacity="0.8" />
                    <ComboBox ItemsSource="{Binding CoordinateFormats}" SelectedItem="{Binding DisplayCoordinateFormat}" MinWidth="170"
                              ToolTip.Tip="Format d'affichage des coordonnées GPS dans tout le logiciel">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CoordinateFormatOption">
                                <TextBlock Text="{Binding ShortLabel}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="{Binding ThemeButtonText}" Command="{Binding ToggleThemeCommand}"
                            ToolTip.Tip="Basculer entre le mode jour et le mode nuit (Ctrl+T)" />
                    <Button Content="⋯" ToolTip.Tip="Plus d'options">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Associer les fichiers .aop à Airsoft Planner" Command="{Binding AssociateFilesCommand}" />
                                <MenuItem Header="Rechercher une mise à jour" Command="{Binding Updates.CheckCommand}" />
                                <MenuItem Header="Site du projet (GitHub)" Command="{Binding OpenProjectSiteCommand}" />
                                <MenuItem Header="À propos" Command="{Binding AboutCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Nouvelle OP" Command="{Binding NewOperationCommand}" ToolTip.Tip="Ctrl+N" />
                    <Button Content="Ouvrir…" Command="{Binding OpenOperationCommand}" ToolTip.Tip="Ctrl+O" />
                    <Button Content="Enregistrer" Command="{Binding SaveCommand}" ToolTip.Tip="Ctrl+S" />
                    <Button Content="Fusionner une copie…" Command="{Binding MergeCopyCommand}"
                            ToolTip.Tip="Intégrer les modifications d'une autre copie de cette OP (fichier reçu d'un autre orga)" />
                    <Button Content="☁ Travail partagé…" Command="{Binding ConfigureSharingCommand}" IsVisible="{Binding !IsShared}"
                            ToolTip.Tip="Travailler à plusieurs via un dossier synchronisé (OneDrive, Google Drive, Dropbox, partage réseau)" />
                    <Button Content="⟳ Synchroniser" Command="{Binding SyncNowCommand}" IsVisible="{Binding IsShared}" />
                    <Button Content="Arrêter le partage" Command="{Binding StopSharingCommand}" IsVisible="{Binding IsShared}" />
                    <TextBlock Text="{Binding SharingStatus}" VerticalAlignment="Center" FontSize="12" Opacity="0.8" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Nouvelle version disponible sur GitHub -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding Updates.HasUpdate}" Background="#262E7D32" BorderBrush="#2E7D32"
                BorderThickness="0,0,0,1" Padding="12,5">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Updates.Banner}" VerticalAlignment="Center" FontWeight="SemiBold" />
                <Button Content="Mettre à jour" Command="{Binding Updates.InstallCommand}" Classes="accent" Padding="8,2"
                        ToolTip.Tip="Télécharge la nouvelle version, l'installe et redémarre le logiciel (l'OP en cours est enregistrée d'abord)" />
                <Button Content="Nouveautés" Command="{Binding Updates.ShowNotesCommand}" Padding="8,2" />
                <Button Content="Plus tard" Command="{Binding Updates.LaterCommand}" Padding="8,2"
                        ToolTip.Tip="Ne plus signaler cette version" />
                <TextBlock Text="{Binding Updates.Status}" VerticalAlignment="Center" Opacity="0.8" />
            </StackPanel>
        </Border>

        <Panel>
            <StackPanel IsVisible="{Binding !HasOperation}" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="Airsoft Planner" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Créez une nouvelle OP ou ouvrez un fichier d'OP (.aop) reçu d'un autre orga."
                           Opacity="0.7" HorizontalAlignment="Center" />
            </StackPanel>

            <Panel IsVisible="{Binding HasOperation}">
                <DockPanel DataContext="{Binding Workspace}" x:DataType="vm:WorkspaceViewModel">
                    <!-- Fréquences radio en double : visible dans tous les onglets, ignorable si c'est voulu -->
                    <Border DockPanel.Dock="Top" IsVisible="{Binding RadioCheck.HasConflicts}" Background="#26E65100"
                            BorderBrush="#E65100" BorderThickness="0,0,0,1" Padding="10,4">
                        <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding RadioCheck.Conflicts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="radio:RadioConflict">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                                            <TextBlock VerticalAlignment="Center">
                                                <Run Text="⚠ Fréquence en double" FontWeight="SemiBold" Foreground="#E65100" />
                                                <Run Text="{Binding Description}" />
                                            </TextBlock>
                                            <Button Content="C'est normal, ignorer" Padding="6,1" FontSize="11"
                                                    Command="{Binding $parent[ItemsControl].((vm:WorkspaceViewModel)DataContext).RadioCheck.IgnoreCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Doublon voulu (ex. faction et équipe de commandement) : il ne sera plus signalé, sauf si une autre équipe prend cette fréquence" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                <TabControl Padding="0">
                    <TabItem Header="Général">
                        <views:GeneralView DataContext="{Binding General}" />
                    </TabItem>
                    <TabItem Header="Orgas">
                        <views:OrganizersView DataContext="{Binding Organizers}" />
                    </TabItem>
                    <TabItem Header="Factions">
                        <views:FactionsView DataContext="{Binding Factions}" />
                    </TabItem>
                    <TabItem Header="Équipes">
                        <views:TeamsView DataContext="{Binding Teams}" />
                    </TabItem>
                    <TabItem Header="Terrain &amp; zones">
                        <views:TerrainView DataContext="{Binding Terrain}" />
                    </TabItem>
                    <TabItem Header="Matériel de jeu">
                        <views:GameItemsView DataContext="{Binding GameItems}" />
                    </TabItem>
                    <TabItem Header="Finances">
                        <views:FinancesView DataContext="{Binding Finances}" />
                    </TabItem>
                    <TabItem Header="Documents">
                        <views:DocumentsView DataContext="{Binding Documents}" />
                    </TabItem>
                    <TabItem Header="Scénario">
                        <TabControl Padding="0" TabStripPlacement="Top" Classes="modes">
                            <TabItem Header="Organisation">
                                <views:MissionsView DataContext="{Binding Missions}" />
                            </TabItem>
                            <TabItem Header="Suivi de l'OP">
                                <views:TrackingView DataContext="{Binding Tracking}" />
                            </TabItem>
                            <TabItem Header="RETEX">
                                <views:RetexView DataContext="{Binding Retex}" />
                            </TabItem>
                        </TabControl>
                    </TabItem>
                </TabControl>
                </DockPanel>
            </Panel>
        </Panel>
    </DockPanel>
</Window>
