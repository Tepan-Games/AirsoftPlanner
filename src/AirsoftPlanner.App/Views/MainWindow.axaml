<Window xmlns="https://github.com/avaloniaui"
        xmlns:l="using:AirsoftPlanner.App.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AirsoftPlanner.App.ViewModels"
        xmlns:views="using:AirsoftPlanner.App.Views"
        xmlns:radio="using:AirsoftPlanner.Core.Radio"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="AirsoftPlanner.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/airsoftplanner.ico"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        Title="{Binding WindowTitle}">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewOperationCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenOperationCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+T" Command="{Binding ToggleThemeCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="12,8" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{l:T coordonnees}" VerticalAlignment="Center" Opacity="0.8" />
                    <ComboBox ItemsSource="{Binding CoordinateFormats}" SelectedItem="{Binding DisplayCoordinateFormat}" MinWidth="170"
                              ToolTip.Tip="{l:T format_d_affichage_des_coordonnees_gps_dans_tout}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CoordinateFormatOption">
                                <TextBlock Text="{Binding ShortLabel}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="{Binding ThemeButtonText}" Command="{Binding ToggleThemeCommand}"
                            ToolTip.Tip="{l:T basculer_entre_le_mode_jour_et_le_mode_nuit_ctrl}" />
                    <Button Content="⋯" ToolTip.Tip="{l:T plus_d_options}">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="{l:T associer_les_fichiers_aop_a_airsoft_planner}" Command="{Binding AssociateFilesCommand}" />
                                <MenuItem Header="{l:T langue_choisir}">
                                    <MenuItem Header="Français" Command="{Binding ChangeLanguageCommand}" CommandParameter="fr" />
                                    <MenuItem Header="English" Command="{Binding ChangeLanguageCommand}" CommandParameter="en" />
                                    <MenuItem Header="Deutsch" Command="{Binding ChangeLanguageCommand}" CommandParameter="de" />
                                    <MenuItem Header="Español" Command="{Binding ChangeLanguageCommand}" CommandParameter="es" />
                                    <MenuItem Header="Italiano" Command="{Binding ChangeLanguageCommand}" CommandParameter="it" />
                                </MenuItem>
                                <MenuItem Header="{l:T rechercher_une_mise_a_jour}" Command="{Binding Updates.CheckCommand}" />
                                <MenuItem Header="{l:T site_du_projet_github}" Command="{Binding OpenProjectSiteCommand}" />
                                <MenuItem Header="{l:T a_propos}" Command="{Binding AboutCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{l:T nouvelle_op}" Command="{Binding NewOperationCommand}" ToolTip.Tip="{l:T ctrl_n}" />
                    <Button Content="{l:T ouvrir}" Command="{Binding OpenOperationCommand}" ToolTip.Tip="{l:T ctrl_o}" />
                    <Button Content="{l:T enregistrer}" Command="{Binding SaveCommand}" ToolTip.Tip="{l:T ctrl_s}" />
                    <Button Content="{l:T fusionner_une_copie}" Command="{Binding MergeCopyCommand}"
                            ToolTip.Tip="{l:T integrer_les_modifications_d_une_autre_copie_de}" />
                    <Button Content="{l:T travail_partage}" Command="{Binding ConfigureSharingCommand}" IsVisible="{Binding !IsShared}"
                            ToolTip.Tip="{l:T travailler_a_plusieurs_via_un_dossier_synchronis}" />
                    <Button Content="{l:T synchroniser}" Command="{Binding SyncNowCommand}" IsVisible="{Binding IsShared}" />
                    <Button Content="{l:T arreter_le_partage}" Command="{Binding StopSharingCommand}" IsVisible="{Binding IsShared}" />
                    <TextBlock Text="{Binding SharingStatus}" VerticalAlignment="Center" FontSize="12" Opacity="0.8" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Nouvelle version disponible sur GitHub -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding Updates.HasUpdate}" Background="#262E7D32" BorderBrush="#2E7D32"
                BorderThickness="0,0,0,1" Padding="12,5">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Updates.Banner}" VerticalAlignment="Center" FontWeight="SemiBold" />
                <Button Content="{l:T mettre_a_jour}" Command="{Binding Updates.InstallCommand}" Classes="accent" Padding="8,2"
                        ToolTip.Tip="{l:T telecharge_la_nouvelle_version_l_installe_et_red}" />
                <Button Content="{l:T nouveautes}" Command="{Binding Updates.ShowNotesCommand}" Padding="8,2" />
                <Button Content="{l:T plus_tard}" Command="{Binding Updates.LaterCommand}" Padding="8,2"
                        ToolTip.Tip="{l:T ne_plus_signaler_cette_version}" />
                <TextBlock Text="{Binding Updates.Status}" VerticalAlignment="Center" Opacity="0.8" />
            </StackPanel>
        </Border>

        <Panel>
            <StackPanel IsVisible="{Binding !HasOperation}" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="{l:T airsoft_planner}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="{l:T creez_une_nouvelle_op_ou_ouvrez_un_fichier_d_op}"
                           Opacity="0.7" HorizontalAlignment="Center" />
            </StackPanel>

            <Panel IsVisible="{Binding HasOperation}">
                <DockPanel DataContext="{Binding Workspace}" x:DataType="vm:WorkspaceViewModel">
                    <!-- Fréquences radio en double : visible dans tous les onglets, ignorable si c'est voulu -->
                    <Border DockPanel.Dock="Top" IsVisible="{Binding RadioCheck.HasConflicts}" Background="#26E65100"
                            BorderBrush="#E65100" BorderThickness="0,0,0,1" Padding="10,4">
                        <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding RadioCheck.Conflicts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="radio:RadioConflict">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                                            <TextBlock VerticalAlignment="Center">
                                                <Run Text="{l:T frequence_en_double}" FontWeight="SemiBold" Foreground="#E65100" />
                                                <Run Text="{Binding Description}" />
                                            </TextBlock>
                                            <Button Content="{l:T c_est_normal_ignorer}" Padding="6,1" FontSize="11"
                                                    Command="{Binding $parent[ItemsControl].((vm:WorkspaceViewModel)DataContext).RadioCheck.IgnoreCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="{l:T doublon_voulu_ex_faction_et_equipe_de_commandeme}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                <TabControl Padding="0">
                    <TabItem Header="{l:T general}">
                        <views:GeneralView DataContext="{Binding General}" />
                    </TabItem>
                    <TabItem Header="{l:T orgas}">
                        <views:OrganizersView DataContext="{Binding Organizers}" />
                    </TabItem>
                    <TabItem Header="{l:T factions}">
                        <views:FactionsView DataContext="{Binding Factions}" />
                    </TabItem>
                    <TabItem Header="{l:T equipes}">
                        <views:TeamsView DataContext="{Binding Teams}" />
                    </TabItem>
                    <TabItem Header="{l:T terrain_zones}">
                        <views:TerrainView DataContext="{Binding Terrain}" />
                    </TabItem>
                    <TabItem Header="{l:T materiel_de_jeu}">
                        <views:GameItemsView DataContext="{Binding GameItems}" />
                    </TabItem>
                    <TabItem Header="{l:T finances}">
                        <views:FinancesView DataContext="{Binding Finances}" />
                    </TabItem>
                    <TabItem Header="{l:T documents}">
                        <views:DocumentsView DataContext="{Binding Documents}" />
                    </TabItem>
                    <TabItem Header="{l:T scenario}">
                        <TabControl Padding="0" TabStripPlacement="Top" Classes="modes">
                            <TabItem Header="{l:T organisation}">
                                <views:MissionsView DataContext="{Binding Missions}" />
                            </TabItem>
                            <TabItem Header="{l:T suivi_de_l_op}">
                                <views:TrackingView DataContext="{Binding Tracking}" />
                            </TabItem>
                            <TabItem Header="RETEX">
                                <views:RetexView DataContext="{Binding Retex}" />
                            </TabItem>
                        </TabControl>
                    </TabItem>
                </TabControl>
                </DockPanel>
            </Panel>
        </Panel>
    </DockPanel>
</Window>
