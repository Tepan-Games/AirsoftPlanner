<Window xmlns="https://github.com/avaloniaui"
        xmlns:l="using:AirsoftPlanner.App.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AirsoftPlanner.App.ViewModels"
        x:Class="AirsoftPlanner.App.Views.TrackingSettingsWindow"
        x:DataType="vm:GpsViewModel"
        Title="{l:T parametres_du_suivi_reception_des_positions}"
        Width="880" Height="760" WindowStartupLocation="CenterOwner" Icon="/Assets/airsoftplanner.ico">
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="6">
            <TextBlock Text="{l:T parametres_du_suivi}" Classes="h1" />
            <TextBlock Text="{Binding ServerStatus}" FontWeight="SemiBold" />
                <TextBlock Text="{l:T smartphones_sur_le_reseau_local_traccar_client_o}" FontWeight="SemiBold" />
                <WrapPanel>
                    <TextBlock Text="{l:T port}" VerticalAlignment="Center" Margin="0,0,6,4" />
                    <NumericUpDown Value="{Binding ServerPort}" Minimum="1024" Maximum="65535" FormatString="0" Width="120" Margin="0,0,8,4" />
                    <ToggleButton Content="{l:T serveur_actif}" IsChecked="{Binding IsServerRunning, Mode=OneWay}"
                                  Command="{Binding ToggleServerCommand}" Margin="0,0,8,4" />
                    <CheckBox Content="{l:T au_lancement}" IsChecked="{Binding AutoStartServer}" Margin="0,0,8,4"
                              ToolTip.Tip="{l:T demarrer_le_serveur_des_l_ouverture_d_une_op_sur}" />
                    <SelectableTextBlock Text="{Binding ServerAddresses}" VerticalAlignment="Center" FontFamily="Consolas,monospace" />
                </WrapPanel>
                <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                           Text="{l:T dans_traccar_client_adresse_du_serveur_une_adres}" />
                <TextBlock Text="{l:T second_poste_suivre_l_op_menee_sur_un_autre_pc}" FontWeight="SemiBold" Margin="0,6,0,0" />
                <WrapPanel>
                    <TextBox Text="{Binding UpstreamUrl}" Width="240" PlaceholderText="http://192.168.1.20:5055" Margin="0,0,6,4" />
                    <ToggleButton Content="{l:T connecte}" IsChecked="{Binding IsUpstreamConnected, Mode=OneWay}"
                                  Command="{Binding ToggleUpstreamCommand}" Margin="0,0,6,4"
                                  ToolTip.Tip="{l:T recupere_toutes_les_10_s_les_positions_collectee}" />
                </WrapPanel>

                <TextBlock Text="{l:T application_android}" FontWeight="SemiBold" Margin="0,6,0,0" />
                <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                           Text="{l:T codes_d_enrolement_et_qr_codes_onglet_equipes_ch}" />
                <WrapPanel>
                    <TextBlock Text="{l:T envoi_toutes_les}" VerticalAlignment="Center" Margin="8,0,6,4" />
                    <NumericUpDown Value="{Binding IntervalSeconds}" Minimum="5" Maximum="3600" Increment="5" FormatString="0" Width="110" Margin="0,0,6,4" />
                    <TextBlock Text="s" VerticalAlignment="Center" Margin="0,0,6,4" />
                </WrapPanel>
                <WrapPanel>
                    <TextBlock Text="{l:T les_telephones_voient}" VerticalAlignment="Center" Margin="0,0,6,4" />
                    <ComboBox ItemsSource="{Binding ShareModes}" SelectedItem="{Binding ShareMode}" MinWidth="280" Margin="0,0,6,4"
                              ToolTip.Tip="{l:T positions_des_equipes_alliees_meme_faction_renvo}" />
                </WrapPanel>
                <WrapPanel>
                    <TextBlock Text="{l:T adresse_publiee}" VerticalAlignment="Center" Margin="0,0,6,4" />
                    <TextBox Text="{Binding ServerAddress}" Width="240" PlaceholderText="{l:T ip_du_pc_ou_monop_duckdns_org}" Margin="0,0,6,4"
                             ToolTip.Tip="{l:T nom_dyndns_ou_adresse_fixe_imprime_dans_les_pack}" />
                    <TextBox Text="{Binding DynDnsUpdateUrl}" Width="320" Margin="0,0,6,4" PasswordChar="•" RevealPassword="{Binding #RevealDynDns.IsChecked}"
                             PlaceholderText="{l:T adresse_de_mise_a_jour_dyndns_avec_ip}"
                             ToolTip.Tip="{l:T ex_duckdns_https_www_duckdns_org_update_domains}" />
                    <CheckBox Name="RevealDynDns" Content="{l:T afficher}" Margin="0,0,6,4" />
                    <Button Content="{l:T mettre_a_jour}" Command="{Binding UpdateDynDnsCommand}" Margin="0,0,6,4" />
                </WrapPanel>
                <TextBlock Text="{Binding DynDnsStatus}" IsVisible="{Binding DynDnsStatus.Length}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                           Text="{l:T si_l_adresse_du_pc_a_change_autre_box_ip_differe}" />
                <WrapPanel IsVisible="{Binding Devices.Count}">
                    <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" MinWidth="320" Margin="0,0,6,4" PlaceholderText="{l:T tous_les_telephones_enroles}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:EnrolledDeviceRow">
                                <TextBlock>
                                    <Run Text="{Binding Team}" FontWeight="SemiBold" />
                                    <Run Text="{Binding Device}" />
                                    <Run Text="{Binding LastSeen}" Foreground="Gray" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="{l:T revoquer}" Command="{Binding RevokeDeviceCommand}" Margin="0,0,6,4"
                            ToolTip.Tip="{l:T le_telephone_ne_pourra_plus_envoyer_de_positions}" />
                </WrapPanel>

                <TextBlock Text="{l:T meshtastic_passerelle_mqtt_messages_json}" FontWeight="SemiBold" Margin="0,6,0,0" />
                <WrapPanel>
                    <TextBox Text="{Binding MqttHost}" Width="150" PlaceholderText="{l:T broker_ex_localhost}" Margin="0,0,6,4" />
                    <NumericUpDown Value="{Binding MqttPort}" Minimum="1" Maximum="65535" FormatString="0" Width="110" Margin="0,0,6,4" />
                    <TextBox Text="{Binding MqttTopic}" Width="120" PlaceholderText="{l:T msh}" Margin="0,0,6,4" />
                    <TextBox Text="{Binding MqttUser}" Width="110" PlaceholderText="{l:T utilisateur}" Margin="0,0,6,4" />
                    <TextBox Text="{Binding MqttPassword}" Width="110" PasswordChar="•" PlaceholderText="{l:T mot_de_passe}" Margin="0,0,6,4" />
                    <ToggleButton Content="{l:T connecte}" IsChecked="{Binding IsMeshtasticConnected, Mode=OneWay}"
                                  Command="{Binding ToggleMeshtasticCommand}" Margin="0,0,6,4" />
                </WrapPanel>

                <TextBlock Text="{l:T serveur_traccar_webservice}" FontWeight="SemiBold" Margin="0,6,0,0" />
                <WrapPanel>
                    <TextBox Text="{Binding TraccarUrl}" Width="220" PlaceholderText="https://traccar.exemple.fr" Margin="0,0,6,4" />
                    <TextBox Text="{Binding TraccarUser}" Width="150" PlaceholderText="{l:T e_mail_vide_jeton}" Margin="0,0,6,4" />
                    <TextBox Text="{Binding TraccarPassword}" Width="130" PasswordChar="•" PlaceholderText="{l:T mot_de_passe_jeton}" Margin="0,0,6,4" />
                    <ToggleButton Content="{l:T connecte}" IsChecked="{Binding IsTraccarConnected, Mode=OneWay}"
                                  Command="{Binding ToggleTraccarCommand}" Margin="0,0,6,4" />
                </WrapPanel>

                <WrapPanel Margin="0,6,0,0">
                    <Button Content="{l:T importer_une_trace_gpx_un_csv}" Command="{Binding ImportFileCommand}" Margin="0,0,6,4"
                            ToolTip.Tip="{l:T gpx_attribue_a_l_equipe_selectionnee_csv_colonne}" />
                </WrapPanel>

                <TextBlock Text="{l:T appareils_inconnus}" FontWeight="SemiBold" Margin="0,6,0,0"
                           IsVisible="{Binding UnknownDevices.Count}" />
                <WrapPanel IsVisible="{Binding UnknownDevices.Count}">
                    <ComboBox ItemsSource="{Binding UnknownDevices}" SelectedItem="{Binding SelectedUnknownDevice}" MinWidth="220" Margin="0,0,6,4">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:UnknownDevice">
                                <TextBlock>
                                    <Run Text="{Binding DeviceId}" FontWeight="SemiBold" />
                                    <Run Text="{Binding Source}" />
                                    <Run Text="{Binding LastSeen}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="{l:T associer_a_l_equipe_selectionnee}" Command="{Binding AssignDeviceCommand}" Margin="0,0,6,4" />
                </WrapPanel>

                <TextBlock Text="{l:T journal}" FontWeight="SemiBold" Margin="0,6,0,0" />
                <ItemsControl ItemsSource="{Binding Journal}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" FontSize="11" FontFamily="Consolas,monospace" Opacity="0.8" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Window>
