<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:l="using:AirsoftPlanner.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AirsoftPlanner.App.ViewModels"
             xmlns:app="using:AirsoftPlanner.App"
             xmlns:conv="using:AirsoftPlanner.App.Converters"
             xmlns:sys="using:System"
             x:Class="AirsoftPlanner.App.Views.FactionsView"
             x:DataType="vm:FactionsViewModel">
    <UserControl.Resources>
        <DataTemplate x:Key="ColorSwatch" x:DataType="sys:String">
            <Border Width="70" Height="18" CornerRadius="3" BorderBrush="Gray" BorderThickness="1"
                    Background="{Binding Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
        </DataTemplate>
    </UserControl.Resources>
    <Grid ColumnDefinitions="300,*">
        <DockPanel Margin="12">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button Content="{l:T ajouter}" Command="{Binding AddCommand}" />
                <Button Content="🗑" Classes="icon" ToolTip.Tip="{l:T supprimer}" AutomationProperties.Name="{l:T supprimer}" Command="{Binding RemoveCommand}" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:FactionViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="16" Height="16" CornerRadius="3" BorderBrush="Gray" BorderThickness="1"
                                    Background="{Binding Color, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock FontSize="11" Opacity="0.65" Text="{Binding StaffingText}" TextWrapping="Wrap" MaxWidth="230"
                                           Classes.warning="{Binding HasStaffingIssue}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <TextBlock Grid.Column="1" IsVisible="{Binding !HasSelection}" Opacity="0.7" Margin="24"
                   Text="{l:T ajoutez_les_camps_de_l_op_ex_otan_insurges_puis}" />

        <ScrollViewer Grid.Column="1" IsVisible="{Binding HasSelection}">
            <StackPanel DataContext="{Binding Selected}" x:DataType="vm:FactionViewModel"
                        Margin="24" MaxWidth="620" HorizontalAlignment="Left" Spacing="12">
                <TextBlock Text="{l:T faction}" Classes="h1" />
                <TextBlock Text="{l:T nom}" Classes="label" />
                <TextBox Text="{Binding Name}" />
                <TextBlock Text="{l:T couleur_carte_frise}" Classes="label" />
                <ComboBox ItemsSource="{x:Static app:ColorPalette.Colors}" SelectedItem="{Binding Color}" Width="120"
                          ItemTemplate="{StaticResource ColorSwatch}" />

                <TextBlock Text="{l:T effectif}" Classes="h2" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{l:T minimum_0_aucun}" Classes="label" />
                        <NumericUpDown Value="{Binding MinPlayers}" Minimum="0" Maximum="5000" Increment="1" FormatString="0" Width="150" />
                    </StackPanel>
                    <StackPanel Spacing="10">
                        <TextBlock Text="{l:T maximum_0_sans_limite}" Classes="label" />
                        <NumericUpDown Value="{Binding MaxPlayers}" Minimum="0" Maximum="5000" Increment="1" FormatString="0" Width="150" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding StaffingText}" TextWrapping="Wrap" Classes.warning="{Binding HasStaffingIssue}" />

                <TextBlock Text="{l:T identification}" Classes="h2" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <CheckBox Content="{l:T brassard}" IsChecked="{Binding HasArmband}" />
                    <ComboBox ItemsSource="{x:Static app:ColorPalette.Colors}" SelectedItem="{Binding ArmbandColor}" Width="120"
                              IsEnabled="{Binding HasArmband}" ItemTemplate="{StaticResource ColorSwatch}" />
                </StackPanel>
                <TextBlock Text="{l:T tenue_camouflage_impose_vide_libre}" Classes="label" />
                <TextBox Text="{Binding Uniform}" PlaceholderText="{l:T ex_multicam_ce_flecktarn_tenue_civile}" />

                <TextBlock Text="{l:T commandement_et_radio}" Classes="h2" Margin="0,8,0,0" />
                <TextBlock Text="{l:T equipe_chef_de_faction}" Classes="label" />
                <ComboBox ItemsSource="{Binding Teams}" SelectedItem="{Binding CommandTeam}" MinWidth="260"
                          PlaceholderText="{l:T aucune_rattachez_d_abord_des_equipes}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:TeamViewModel">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{l:T frequence_radio_de_commandement_faction}" Classes="label" />
                <TextBox Text="{Binding RadioFrequency}" PlaceholderText="{l:T ex_pmr_446_canal_1_446_00625_mhz}" />
                <TextBlock Text="{l:T difficulte_onglet_qg}" Classes="label" />
                <ComboBox ItemsSource="{Binding Difficulties}" SelectedItem="{Binding Difficulty}" MinWidth="260" ToolTip.Tip="{l:T difficulte_aide}" />
                <TextBlock Text="{Binding DifficultyExplanation}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                <TextBlock Text="{l:T frequences_des_equipes}" Classes="label" />
                <ItemsControl ItemsSource="{Binding Teams}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TeamViewModel">
                            <TextBlock>
                                <Run Text="{Binding Name}" FontWeight="SemiBold" />
                                <Run Text=" : " />
                                <Run Text="{Binding RadioFrequency}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{l:T description_objectifs_generaux_background}" Classes="label" />
                <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
