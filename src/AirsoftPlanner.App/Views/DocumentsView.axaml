<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:l="using:AirsoftPlanner.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AirsoftPlanner.App.ViewModels"
             xmlns:conv="using:AirsoftPlanner.App.Converters"
             x:Class="AirsoftPlanner.App.Views.DocumentsView"
             x:DataType="vm:DocumentsViewModel">
    <Grid ColumnDefinitions="*,6,*">
        <!-- Règles du jeu -->
        <DockPanel Margin="12">
            <TextBlock DockPanel.Dock="Top" Text="{l:T regles_du_jeu}" Classes="h1" />
            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="12" Opacity="0.7" Margin="0,4,0,8"
                       Text="{l:T importez_vos_documents_existants_pdf_word_ou_red}" />
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                <Button Content="{l:T importer_un_document}" Command="{Binding ImportRuleCommand}" />
                <Button Content="{l:T rediger}" Command="{Binding WriteRuleCommand}" />
                <Button Content="▲" Command="{Binding MoveRuleUpCommand}" ToolTip.Tip="{l:T monter}" />
                <Button Content="▼" Command="{Binding MoveRuleDownCommand}" ToolTip.Tip="{l:T descendre}" />
                <Button Content="🗑" Classes="icon" ToolTip.Tip="{l:T supprimer}" AutomationProperties.Name="{l:T supprimer}" Command="{Binding RemoveRuleCommand}" />
            </StackPanel>
            <Border DockPanel.Dock="Top" IsVisible="{Binding IsAcp}" Background="#1A1565C0" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                <StackPanel Spacing="4">
                    <WrapPanel ItemSpacing="8" LineSpacing="4">
                        <TextBlock Text="{l:T reglement_acp_choisi_pour_l_op}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Content="🔄" Classes="icon" Command="{Binding UpdateAcpRulesCommand}"
                                ToolTip.Tip="{l:T mettre_a_jour_le_reglement_acp}" AutomationProperties.Name="{l:T mettre_a_jour_le_reglement_acp}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding AcpStatus}" IsVisible="{Binding AcpStatus.Length}" TextWrapping="Wrap" FontSize="12" />
                    <TextBlock Text="{l:T reglement_acp_licence}" TextWrapping="Wrap" FontSize="11" Opacity="0.7" />
                </StackPanel>
            </Border>
            <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" MaxHeight="180">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:RuleDocumentViewModel">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding KindText}" FontSize="11" Opacity="0.65" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,10,0,6" IsVisible="{Binding HasSelectedRule}">
                <TextBlock Text="{l:T titre}" Classes="label" />
                <TextBox Text="{Binding SelectedRule.Title, FallbackValue=''}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{l:T ouvrir_apercu_pdf}" Command="{Binding OpenRuleCommand}" />
                    <Button Content="{l:T remplacer_le_fichier}" Command="{Binding ReplaceRuleFileCommand}"
                            IsVisible="{Binding SelectedRule.IsImported, FallbackValue=False}" />
                </StackPanel>
                <TextBlock IsVisible="{Binding SelectedRule.IsWritten, FallbackValue=False}" FontSize="11" Opacity="0.65" TextWrapping="Wrap"
                           Text="{l:T mise_en_forme_une_ligne_titre_ouvre_une_section}" />
            </StackPanel>
            <TextBox Text="{Binding SelectedRule.Text, FallbackValue=''}" AcceptsReturn="True" TextWrapping="Wrap"
                     IsVisible="{Binding SelectedRule.IsWritten, FallbackValue=False}" FontFamily="Consolas,monospace" />
        </DockPanel>

        <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

        <!-- Diffusion -->
        <DockPanel Grid.Column="2" Margin="12">
            <TextBlock DockPanel.Dock="Top" Text="{l:T packages_des_equipes}" Classes="h1" />
            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="12" Opacity="0.7" Margin="0,4,0,8"
                       Text="{l:T chaque_package_contient_l_ordre_de_mission_initi}" />
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="{l:T generer_tous_les_packages}" Command="{Binding GenerateAllCommand}" />
                    <Button Content="{l:T generer_pour_l_equipe}" Command="{Binding GenerateSelectedCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding Summary}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
            </DockPanel>
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsGenerating}" Margin="0,0,0,6" />

            <Border DockPanel.Dock="Bottom" Padding="0,8,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{l:T marquer_envoye}" Command="{Binding MarkSentCommand}" />
                    <TextBox Text="{Binding SelectedPackage.ReceivedByInput, FallbackValue=''}" Width="200"
                             PlaceholderText="{l:T confirme_par}" />
                    <Button Content="{l:T marquer_recu}" Command="{Binding MarkReceivedCommand}" />
                    <Button Content="{l:T ouvrir_le_dossier}" Command="{Binding OpenPackageFolderCommand}" />
                </StackPanel>
            </Border>

            <ListBox ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PackageRowViewModel">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Width="12" Height="12" CornerRadius="6" Margin="0,4,10,0" VerticalAlignment="Top"
                                    Background="{Binding StatusColor, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock>
                                    <Run Text="{Binding Team.Name}" FontWeight="SemiBold" />
                                    <Run Text=" — " />
                                    <Run Text="{Binding StatusLabel}"
                                         Foreground="{Binding StatusColor, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                                </TextBlock>
                                <TextBlock Text="{Binding ContactText}" FontSize="11" Opacity="0.75" />
                                <TextBlock Text="{Binding HistoryText}" FontSize="11" Opacity="0.6" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</UserControl>
