<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AirsoftPlanner.App.ViewModels"
             xmlns:conv="using:AirsoftPlanner.App.Converters"
             x:Class="AirsoftPlanner.App.Views.DocumentsView"
             x:DataType="vm:DocumentsViewModel">
    <Grid ColumnDefinitions="*,6,*">
        <!-- Règles du jeu -->
        <DockPanel Margin="12">
            <TextBlock DockPanel.Dock="Top" Text="Règles du jeu" Classes="h1" />
            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="12" Opacity="0.7" Margin="0,4,0,8"
                       Text="Importez vos documents existants (PDF, Word…) ou rédigez les règles propres à l'OP. Ils sont joints, dans cet ordre, au package de chaque équipe." />
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                <Button Content="Importer un document…" Command="{Binding ImportRuleCommand}" />
                <Button Content="Rédiger" Command="{Binding WriteRuleCommand}" />
                <Button Content="▲" Command="{Binding MoveRuleUpCommand}" ToolTip.Tip="Monter" />
                <Button Content="▼" Command="{Binding MoveRuleDownCommand}" ToolTip.Tip="Descendre" />
                <Button Content="Supprimer" Command="{Binding RemoveRuleCommand}" />
            </StackPanel>
            <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" MaxHeight="180">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:RuleDocumentViewModel">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding KindText}" FontSize="11" Opacity="0.65" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,10,0,6" IsVisible="{Binding HasSelectedRule}">
                <TextBlock Text="Titre" Classes="label" />
                <TextBox Text="{Binding SelectedRule.Title, FallbackValue=''}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Ouvrir / aperçu PDF" Command="{Binding OpenRuleCommand}" />
                    <Button Content="Remplacer le fichier…" Command="{Binding ReplaceRuleFileCommand}"
                            IsVisible="{Binding SelectedRule.IsImported, FallbackValue=False}" />
                </StackPanel>
                <TextBlock IsVisible="{Binding SelectedRule.IsWritten, FallbackValue=False}" FontSize="11" Opacity="0.65" TextWrapping="Wrap"
                           Text="Mise en forme : une ligne « # Titre » ouvre une section, une ligne « - texte » fait une puce." />
            </StackPanel>
            <TextBox Text="{Binding SelectedRule.Text, FallbackValue=''}" AcceptsReturn="True" TextWrapping="Wrap"
                     IsVisible="{Binding SelectedRule.IsWritten, FallbackValue=False}" FontFamily="Consolas,monospace" />
        </DockPanel>

        <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

        <!-- Diffusion -->
        <DockPanel Grid.Column="2" Margin="12">
            <TextBlock DockPanel.Dock="Top" Text="Packages des équipes" Classes="h1" />
            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="12" Opacity="0.7" Margin="0,4,0,8"
                       Text="Chaque package contient l'ordre de mission initial de l'équipe (PDF avec carte) et les règles, dans un dossier et une archive ZIP à envoyer au chef d'équipe. Pointez l'envoi puis la confirmation de réception." />
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Générer tous les packages…" Command="{Binding GenerateAllCommand}" />
                    <Button Content="Générer pour l'équipe" Command="{Binding GenerateSelectedCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding Summary}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
            </DockPanel>
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsGenerating}" Margin="0,0,0,6" />

            <Border DockPanel.Dock="Bottom" Padding="0,8,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Marquer envoyé" Command="{Binding MarkSentCommand}" />
                    <TextBox Text="{Binding SelectedPackage.ReceivedByInput, FallbackValue=''}" Width="200"
                             PlaceholderText="Confirmé par…" />
                    <Button Content="Marquer reçu" Command="{Binding MarkReceivedCommand}" />
                    <Button Content="Ouvrir le dossier" Command="{Binding OpenPackageFolderCommand}" />
                </StackPanel>
            </Border>

            <ListBox ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PackageRowViewModel">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Width="12" Height="12" CornerRadius="6" Margin="0,4,10,0" VerticalAlignment="Top"
                                    Background="{Binding StatusColor, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock>
                                    <Run Text="{Binding Team.Name}" FontWeight="SemiBold" />
                                    <Run Text=" — " />
                                    <Run Text="{Binding StatusLabel}"
                                         Foreground="{Binding StatusColor, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                                </TextBlock>
                                <TextBlock Text="{Binding ContactText}" FontSize="11" Opacity="0.75" />
                                <TextBlock Text="{Binding HistoryText}" FontSize="11" Opacity="0.6" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</UserControl>
