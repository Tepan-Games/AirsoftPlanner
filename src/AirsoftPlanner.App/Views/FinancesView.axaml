<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:l="using:AirsoftPlanner.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AirsoftPlanner.App.ViewModels"
             xmlns:conv="using:AirsoftPlanner.App.Converters"
             x:Class="AirsoftPlanner.App.Views.FinancesView"
             x:DataType="vm:FinancesViewModel">
    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="MinWidth" Value="190" />
        </Style>
        <Style Selector="TextBlock.amount">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,2" />
        </Style>
        <!-- Libellé de carte : sans la marge négative du style « label » des formulaires. -->
        <Style Selector="Border.card TextBlock.cardlabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.75" />
        </Style>
        <Style Selector="Border.card TextBlock.cardnote">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
    </UserControl.Styles>
    <DockPanel Margin="12">
        <!-- Bilan -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <TextBlock Text="{l:T participation_par_joueur}" VerticalAlignment="Center" />
                <TextBox Text="{Binding PricePerPlayerText}" Width="80" />
                <TextBlock Text="{l:T carburant_rembourse_km}" VerticalAlignment="Center"
                           ToolTip.Tip="{l:T pour_les_vehicules_mis_en_jeu_onglet_equipes_kil}" />
                <TextBox Text="{Binding FuelRatePerKmText}" Width="80" />
                <Button Content="{l:T exporter_csv}" Command="{Binding ExportCsvCommand}" />
            </StackPanel>
            <TextBlock Text="{l:T finances_de_l_op}" Classes="h1" />
        </DockPanel>
        <WrapPanel DockPanel.Dock="Top">
            <Border Classes="card">
                <StackPanel Spacing="2">
                    <TextBlock Text="{l:T recettes_encaissees}" Classes="cardlabel" />
                    <TextBlock Text="{Binding ReceivedIncomeText}" Classes="amount" />
                    <TextBlock Classes="cardnote">
                        <Run Text="{l:T sur}" />
                        <Run Text="{Binding ExpectedIncomeText}" />
                        <Run Text="{l:T attendus}" />
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Classes="card">
                <StackPanel Spacing="2">
                    <TextBlock Text="{l:T reste_a_encaisser}" Classes="cardlabel" />
                    <TextBlock Text="{Binding OutstandingText}" Classes="amount" Foreground="#EF6C00" />
                </StackPanel>
            </Border>
            <Border Classes="card" IsVisible="{Binding HasRefunds}">
                <StackPanel Spacing="2">
                    <TextBlock Text="{l:T remboursements_a_faire}" Classes="cardlabel" />
                    <TextBlock Text="{Binding RefundsText}" Classes="amount" Foreground="#6A1B9A" />
                    <TextBlock Text="{l:T trop_percus_remises_apres_paiement}" Classes="cardnote" />
                </StackPanel>
            </Border>
            <Border Classes="card">
                <StackPanel Spacing="2">
                    <TextBlock Text="{l:T depenses}" Classes="cardlabel" />
                    <TextBlock Text="{Binding ExpensesText}" Classes="amount" />
                    <TextBlock Classes="cardnote">
                        <Run Text="{l:T dont}" />
                        <Run Text="{Binding UnpaidExpensesText}" />
                        <Run Text="{l:T a_payer}" />
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Classes="card">
                <StackPanel Spacing="2">
                    <TextBlock Text="{l:T tresorerie_actuelle}" Classes="cardlabel" />
                    <TextBlock Text="{Binding CurrentBalanceText}" Classes="amount" />
                    <TextBlock Text="{l:T encaisse_depenses_reglees}" Classes="cardnote" />
                </StackPanel>
            </Border>
            <Border Classes="card">
                <StackPanel Spacing="2">
                    <TextBlock Text="{l:T bilan_previsionnel}" Classes="cardlabel" />
                    <TextBlock Text="{Binding ProjectedBalanceText}" Classes="amount" Classes.warning="{Binding IsProjectedNegative}" />
                    <TextBlock Text="{l:T recettes_attendues_toutes_les_depenses}" Classes="cardnote" />
                </StackPanel>
            </Border>
        </WrapPanel>

        <Grid ColumnDefinitions="*,12,*">
            <!-- Participation des équipes -->
            <Grid RowDefinitions="Auto,*,Auto,Auto">
                <TextBlock Text="{l:T participation_des_equipes}" Classes="h2" Margin="0,0,0,6" />
                <ListBox Grid.Row="1" ItemsSource="{Binding TeamRows}" SelectedItem="{Binding SelectedTeam}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:TeamFinanceRow">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Width="12" Height="12" CornerRadius="6" Margin="0,4,10,0" VerticalAlignment="Top"
                                        Background="{Binding StatusColor, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Team.Name}" FontWeight="SemiBold" />
                                    <TextBlock FontSize="11" Opacity="0.7">
                                        <Run Text="{Binding Team.SizeText}" />
                                        <Run Text="·" />
                                        <Run Text="{Binding StatusLabel}"
                                             Foreground="{Binding StatusColor, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <TextBlock HorizontalAlignment="Right">
                                        <Run Text="{Binding PaidText}" FontWeight="SemiBold" />
                                        <Run Text="/" />
                                        <Run Text="{Binding DueText}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding RemainingText}" FontSize="11" HorizontalAlignment="Right" Opacity="0.75" />
                                    <TextBlock Text="{Binding BreakdownText}" FontSize="10" HorizontalAlignment="Right" Opacity="0.6" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Spacing="6" Margin="0,8,0,0" IsVisible="{Binding SelectedTeam, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{l:T somme_due_fixee_vide_effectif_tarif}" VerticalAlignment="Center" />
                        <TextBox Text="{Binding SelectedTeam.OverrideText, FallbackValue=''}" Width="90" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding SelectedTeam.Credits, FallbackValue={x:Null}}" SelectedItem="{Binding SelectedCredit}" MaxHeight="110">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CreditRow">
                                <TextBlock FontSize="12">
                                    <Run Text="{Binding Text}" />
                                    <Run Text="{Binding AmountText}" FontWeight="SemiBold" Foreground="#2E7D32" />
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel>
                        <ComboBox ItemsSource="{Binding AdjustmentKinds}" SelectedItem="{Binding NewAdjustmentKind}" MinWidth="100" Margin="0,0,6,4" />
                        <TextBox Text="{Binding NewAdjustmentLabel}" Width="170" PlaceholderText="{l:T motif_ex_vehicule_en_jeu}" Margin="0,0,6,4" />
                        <TextBox Text="{Binding NewAdjustmentAmount}" Width="80" PlaceholderText="{l:T montant}" Margin="0,0,6,4" />
                        <Button Content="{l:T accorder}" Command="{Binding AddAdjustmentCommand}" Margin="0,0,6,4" />
                        <Button Content="✕" Classes="icon" ToolTip.Tip="{l:T retirer}" AutomationProperties.Name="{l:T retirer}" Command="{Binding RemoveAdjustmentCommand}" Margin="0,0,6,4" />
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding TeamPayments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PaymentRow">
                                <TextBlock FontSize="12">
                                    <Run Text="{Binding DateText}" />
                                    <Run Text="—" />
                                    <Run Text="{Binding AmountText}" FontWeight="SemiBold" />
                                    <Run Text="{Binding MethodText}" />
                                    <Run Text="{Binding Details}" Foreground="Gray" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <WrapPanel Grid.Row="3" Margin="0,6,0,0">
                    <TextBox Text="{Binding NewAmount}" Width="90" PlaceholderText="{l:T montant}" Margin="0,0,6,4" />
                    <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding NewMethod}" MinWidth="130" Margin="0,0,6,4" />
                    <TextBox Text="{Binding NewReference}" Width="150" PlaceholderText="{l:T reference_virement}" Margin="0,0,6,4" />
                    <Button Content="{l:T enregistrer_le_paiement}" Command="{Binding AddPaymentCommand}" Margin="0,0,6,4" />
                    <ComboBox ItemsSource="{Binding TeamPayments}" SelectedItem="{Binding SelectedPayment}" MinWidth="150"
                              PlaceholderText="{l:T paiement_a_annuler}" Margin="0,0,6,4">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PaymentRow">
                                <TextBlock>
                                    <Run Text="{Binding DateText}" />
                                    <Run Text="{Binding AmountText}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="{l:T annuler_ce_paiement}" Command="{Binding RemovePaymentCommand}" Margin="0,0,6,4" />
                </WrapPanel>
            </Grid>

            <!-- Dépenses et autres recettes -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                <DockPanel Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                        <Button Content="{l:T depense}" Command="{Binding AddExpenseCommand}" />
                        <Button Content="🗑" Classes="icon" ToolTip.Tip="{l:T supprimer}" AutomationProperties.Name="{l:T supprimer}" Command="{Binding RemoveExpenseCommand}" />
                    </StackPanel>
                    <TextBlock Text="{l:T depenses_fournitures_prestataires}" Classes="h2" />
                </DockPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Expenses}" SelectedItem="{Binding SelectedExpense}"
                          AutoGenerateColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="1"
                          BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:T libelle}" Binding="{Binding Label}" Width="2*" />
                        <DataGridTemplateColumn Header="{l:T categorie}" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:ExpenseViewModel">
                                    <ComboBox ItemsSource="{x:Static vm:ExpenseCategoryOption.All}" SelectedItem="{Binding Category}"
                                              HorizontalAlignment="Stretch" BorderThickness="0" Background="Transparent" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{l:T fournisseur}" Binding="{Binding Supplier}" Width="*" />
                        <DataGridTextColumn Header="{l:T montant_2}" Binding="{Binding AmountText}" Width="100" />
                        <DataGridCheckBoxColumn Header="{l:T payee}" Binding="{Binding IsPaid}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="2" Text="{l:T autres_recettes_sponsor_buvette_subvention}" Classes="h2" Margin="0,12,0,6" />
                <ListBox Grid.Row="3" ItemsSource="{Binding OtherIncome}" SelectedItem="{Binding SelectedIncome}" MaxHeight="130">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PaymentRow">
                            <TextBlock>
                                <Run Text="{Binding DateText}" />
                                <Run Text="—" />
                                <Run Text="{Binding Details}" FontWeight="SemiBold" />
                                <Run Text="{Binding AmountText}" />
                                <Run Text="{Binding MethodText}" Foreground="Gray" />
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel Grid.Row="4" Margin="0,6,0,0">
                    <TextBox Text="{Binding NewIncomeLabel}" Width="180" PlaceholderText="{l:T libelle_ex_sponsor}" Margin="0,0,6,4" />
                    <TextBox Text="{Binding NewIncomeAmount}" Width="90" PlaceholderText="{l:T montant}" Margin="0,0,6,4" />
                    <Button Content="{l:T ajouter_la_recette}" Command="{Binding AddIncomeCommand}" Margin="0,0,6,4" />
                    <Button Content="🗑" Classes="icon" ToolTip.Tip="{l:T supprimer}" AutomationProperties.Name="{l:T supprimer}" Command="{Binding RemoveIncomeCommand}" Margin="0,0,6,4" />
                </WrapPanel>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
