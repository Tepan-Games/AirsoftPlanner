<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AirsoftPlanner.App.ViewModels"
             x:Class="AirsoftPlanner.App.Views.GeneralView"
             x:DataType="vm:OperationViewModel">
    <ScrollViewer>
        <StackPanel Margin="24" MaxWidth="640" HorizontalAlignment="Left" Spacing="12">
            <TextBlock Text="Informations générales" Classes="h1" />
            <TextBlock Text="Nom de l'OP" Classes="label" />
            <TextBox Text="{Binding Name}" />
            <TextBlock Text="Terrain / lieu" Classes="label" />
            <TextBox Text="{Binding Location}" />
            <Grid ColumnDefinitions="Auto,12,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                <TextBlock Text="Date de début" Classes="label" />
                <TextBlock Grid.Column="2" Text="Heure de début" Classes="label" />
                <CalendarDatePicker Grid.Row="1" SelectedDate="{Binding StartDate}" Margin="0,10,0,0"
                                    ToolTip.Tip="Changer la date de début déplace toute l'OP, missions comprises" />
                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding StartTimeText}" Width="100" Margin="0,10,0,0" />
                <TextBlock Grid.Row="2" Text="Date de fin" Classes="label" Margin="0,14,0,-6" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Heure de fin" Classes="label" Margin="0,14,0,-6" />
                <CalendarDatePicker Grid.Row="3" SelectedDate="{Binding EndDate}" Margin="0,10,0,0" />
                <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding EndTimeText}" Width="100" Margin="0,10,0,0" />
            </Grid>
            <TextBlock Text="{Binding DurationText}" Opacity="0.7" />
            <TextBlock Text="Vitesse de déplacement à pied (km/h), pour estimer les retards" Classes="label" />
            <NumericUpDown Value="{Binding WalkingSpeedKmh}" Minimum="0.5" Maximum="20" Increment="0.5"
                           FormatString="0.0" Width="140" HorizontalAlignment="Left" />
            <TextBlock Text="Format des coordonnées dans les documents imprimés (l'affichage à l'écran se règle dans la barre du haut)" TextWrapping="Wrap" Classes="label" />
            <ComboBox ItemsSource="{Binding CoordinateFormats}" SelectedItem="{Binding SelectedCoordinateFormat}"
                      MinWidth="320" />
            <TextBlock Text="Description / contexte" Classes="label" />
            <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
