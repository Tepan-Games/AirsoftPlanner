<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:l="using:AirsoftPlanner.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AirsoftPlanner.App.ViewModels"
             x:Class="AirsoftPlanner.App.Views.GeneralView"
             x:DataType="vm:OperationViewModel">
    <ScrollViewer>
        <StackPanel Margin="24" MaxWidth="640" HorizontalAlignment="Left" Spacing="12">
            <TextBlock Text="{l:T informations_generales}" Classes="h1" />
            <TextBlock Text="{l:T nom_de_l_op}" Classes="label" />
            <TextBox Text="{Binding Name}" />
            <TextBlock Text="{l:T organise_par_equipe_ou_association}" Classes="label" />
            <TextBox Text="{Binding OrganizerName}" PlaceholderText="{l:T ex_association_airsoft_du_gatinais}" />
            <TextBlock Text="{l:T terrain_lieu}" Classes="label" />
            <TextBox Text="{Binding Location}" />
            <Grid ColumnDefinitions="Auto,12,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                <TextBlock Text="{l:T date_de_debut}" Classes="label" />
                <TextBlock Grid.Column="2" Text="{l:T heure_de_debut}" Classes="label" />
                <CalendarDatePicker Grid.Row="1" SelectedDate="{Binding StartDate}" Margin="0,10,0,0"
                                    ToolTip.Tip="{l:T changer_la_date_de_debut_deplace_toute_l_op_miss}" />
                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding StartTimeText}" Width="100" Margin="0,10,0,0" />
                <TextBlock Grid.Row="2" Text="{l:T date_de_fin}" Classes="label" Margin="0,14,0,-6" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{l:T heure_de_fin}" Classes="label" Margin="0,14,0,-6" />
                <CalendarDatePicker Grid.Row="3" SelectedDate="{Binding EndDate}" Margin="0,10,0,0" />
                <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding EndTimeText}" Width="100" Margin="0,10,0,0" />
            </Grid>
            <TextBlock Text="{Binding DurationText}" Opacity="0.7" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <StackPanel Spacing="10">
                    <TextBlock Text="{l:T frequence_radio_de_l_orga}" Classes="label" />
                    <TextBox Text="{Binding OrgaRadioFrequency}" Width="200" PlaceholderText="{l:T ex_pmr_446_canal_8}" />
                </StackPanel>
                <StackPanel Spacing="10">
                    <TextBlock Text="{l:T numero_d_urgence_de_l_orga}" Classes="label" />
                    <TextBox Text="{Binding EmergencyPhone}" Width="200" PlaceholderText="{l:T ex_06_00_00_00_00}" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="{l:T vitesses_estimees_km_h_pour_estimer_les_retards}" Classes="label" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{l:T a_pied}" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding WalkingSpeedKmh}" Minimum="0.5" Maximum="20" Increment="0.5"
                               FormatString="0.0" Width="140" />
                <TextBlock Text="{l:T en_vehicule}" VerticalAlignment="Center" Margin="16,0,0,0" />
                <NumericUpDown Value="{Binding VehicleSpeedKmh}" Minimum="1" Maximum="120" Increment="5"
                               FormatString="0" Width="140"
                               ToolTip.Tip="{l:T utilisee_pour_les_equipes_qui_ont_un_vehicule_en}" />
            </StackPanel>
            <TextBlock Text="{l:T format_des_coordonnees_dans_les_documents_imprim}" TextWrapping="Wrap" Classes="label" />
            <ComboBox ItemsSource="{Binding CoordinateFormats}" SelectedItem="{Binding SelectedCoordinateFormat}"
                      MinWidth="320" />
            <TextBlock Text="{l:T reglement_de_jeu}" Classes="label" />
            <ComboBox ItemsSource="{Binding RuleSets}" SelectedItem="{Binding SelectedRuleSet}" MinWidth="320" />
            <TextBlock Text="{l:T reglement_acp_aide}" IsVisible="{Binding IsAcp}" TextWrapping="Wrap" FontSize="12" Opacity="0.75" />
            <TextBlock Text="{l:T description_contexte}" Classes="label" />
            <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
