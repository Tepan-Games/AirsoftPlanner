<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:l="using:AirsoftPlanner.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AirsoftPlanner.App.ViewModels"
             xmlns:controls="using:AirsoftPlanner.App.Controls"
             xmlns:conv="using:AirsoftPlanner.App.Converters"
             x:Class="AirsoftPlanner.App.Views.TeamsView"
             x:DataType="vm:TeamsViewModel">
    <Grid ColumnDefinitions="280,*">
        <DockPanel Margin="12">
            <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6" />
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button Content="{l:T importer_csv}" Command="{Binding ImportCsvCommand}" Margin="0,0,6,6"
                        ToolTip.Tip="{l:T inscriptions_exportees_d_un_formulaire_google_fo}" />
                <Button Content="{l:T exporter}" Command="{Binding ExportCsvCommand}" Margin="0,0,6,6" />
                <Button Content="{l:T liste_d_attente}" Command="{Binding PromoteWaitingCommand}" Margin="0,0,6,6"
                        ToolTip.Tip="{l:T faire_entrer_les_equipes_en_attente_la_ou_des_pl}" />
            </WrapPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button Content="{l:T ajouter}" Command="{Binding AddCommand}" />
                <Button Content="🗑" Classes="icon" ToolTip.Tip="{l:T supprimer}" AutomationProperties.Name="{l:T supprimer}" Command="{Binding RemoveCommand}" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:TeamViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="16" Height="16" CornerRadius="8" BorderBrush="Gray" BorderThickness="1"
                                    Background="{Binding Faction.Color, FallbackValue={x:Null}, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock FontSize="11" Opacity="0.6">
                                    <Run Text="{Binding Faction.Name, FallbackValue={l:T sans_faction}}" />
                                    <Run Text="·" />
                                    <Run Text="{Binding SizeText}" />
                                </TextBlock>
                                <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding Status.Label}"
                                           Foreground="{Binding Status.Color, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <TextBlock Grid.Column="1" IsVisible="{Binding !HasSelection}" Opacity="0.7" Margin="24"
                   Text="{l:T ajoutez_les_equipes_participantes_leurs_membres}" />

        <ScrollViewer Grid.Column="1" IsVisible="{Binding HasSelection}">
            <StackPanel Margin="20" Spacing="10">
                <TextBlock Text="{l:T equipe}" Classes="h1" />
                <WrapPanel>
                    <StackPanel Spacing="10" Margin="0,0,16,8" Width="260">
                        <TextBlock Text="{l:T nom}" Classes="label" />
                        <TextBox Text="{Binding Selected.Name, FallbackValue=''}" />
                    </StackPanel>
                    <StackPanel Spacing="10" Margin="0,0,16,8">
                        <TextBlock Text="{l:T faction}" Classes="label" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ComboBox ItemsSource="{Binding Factions}" SelectedItem="{Binding Selected.Faction, FallbackValue={x:Null}}"
                                      MinWidth="200" PlaceholderText="{l:T sans_faction}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FactionViewModel">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Width="14" Height="14" CornerRadius="3"
                                                    Background="{Binding Color, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                                            <TextBlock Text="{Binding Name}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="✕" Classes="icon" ToolTip.Tip="{l:T retirer}" AutomationProperties.Name="{l:T retirer}" Command="{Binding ClearFactionCommand}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="10" Margin="0,0,16,8">
                        <TextBlock Text="{l:T inscription}" Classes="label" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Selected.Status, FallbackValue={x:Null}}" MinWidth="150" />
                            <CalendarDatePicker SelectedDate="{Binding Selected.RegisteredAt, FallbackValue={x:Null}}"
                                                ToolTip.Tip="{l:T date_d_inscription_ordre_de_la_liste_d_attente}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="10" Margin="0,0,16,8" Width="230">
                        <TextBlock Text="{l:T identifiants_gps_appareils}" Classes="label" />
                        <TextBox Text="{Binding Selected.GpsDeviceIds, FallbackValue=''}" PlaceholderText="{l:T ex_alpha_tel_a1b2c3d4}"
                                 ToolTip.Tip="{l:T identifiant_saisi_dans_traccar_client_ou_identif}" />
                    </StackPanel>
                    <StackPanel Spacing="10" Margin="0,0,16,8">
                        <TextBlock Text="{l:T symbole_sur_les_cartes}" Classes="label" />
                        <ComboBox ItemsSource="{x:Static vm:MilSymbolOption.ForTeams}" SelectedItem="{Binding Selected.Symbol, FallbackValue={x:Null}}" MinWidth="230">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:MilSymbolOption">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <controls:SymbolView Symbol="{Binding Preview}" Width="40" Height="28" />
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Spacing="10" Margin="0,0,16,8" Width="200">
                        <TextBlock Text="{l:T frequence_radio_de_l_equipe}" Classes="label" />
                        <TextBox Text="{Binding Selected.RadioFrequency, FallbackValue=''}" PlaceholderText="{l:T ex_pmr_446_canal_3}" />
                    </StackPanel>
                    <StackPanel Spacing="10" Margin="0,0,16,8">
                        <TextBlock Text="{l:T effectif_annonce}" Classes="label" />
                        <NumericUpDown Value="{Binding Selected.PlayerCount, FallbackValue=0}" Minimum="0" Maximum="500"
                                       Increment="1" FormatString="0" Width="140" />
                    </StackPanel>
                </WrapPanel>

                <TextBlock Classes="h2" Margin="0,8,0,0">
                    <Run Text="{l:T membres}" />
                    <Run Text="{Binding Selected.SizeText, FallbackValue=''}" FontWeight="Normal" FontSize="13" />
                </TextBlock>
                <TextBlock Text="{Binding Selected.LeaderText, FallbackValue=''}" FontSize="12" Opacity="0.75" />
                <DataGrid ItemsSource="{Binding Selected.Members, FallbackValue={x:Null}}" SelectedItem="{Binding SelectedMember}"
                          AutoGenerateColumns="False" CanUserSortColumns="True" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column" MinHeight="140" MaxHeight="360" BorderThickness="1"
                          BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="{l:T chef}" Binding="{Binding IsLeader}" Width="72" />
                        <DataGridTextColumn Header="{l:T prenom}" Binding="{Binding FirstName}" Width="*" />
                        <DataGridTextColumn Header="{l:T nom}" Binding="{Binding LastName}" Width="*" />
                        <DataGridTextColumn Header="{l:T pseudo_indicatif}" Binding="{Binding Callsign}" Width="*" />
                        <DataGridTextColumn Header="{l:T role}" Binding="{Binding Role}" Width="*" />
                        <DataGridTextColumn Header="{l:T portable}" Binding="{Binding Phone}" Width="*" />
                        <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="1.4*" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{l:T membre}" Command="{Binding AddMemberCommand}" />
                    <Button Content="{l:T retirer_le_membre}" Command="{Binding RemoveMemberCommand}" />
                </StackPanel>

                <TextBlock Classes="h2" Margin="0,8,0,0">
                    <Run Text="{l:T vehicules}" />
                    <Run Text="{Binding Selected.VehicleSummary, FallbackValue=''}" FontWeight="Normal" FontSize="13" />
                </TextBlock>
                <DataGrid ItemsSource="{Binding Selected.Vehicles, FallbackValue={x:Null}}" SelectedItem="{Binding SelectedVehicle}"
                          AutoGenerateColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          MinHeight="80" MaxHeight="220" BorderThickness="1"
                          BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:T type_4x4_quad_pick_up}" Binding="{Binding Kind}" Width="*" />
                        <DataGridTextColumn Header="{l:T nombre}" Binding="{Binding Quantity}" Width="80" />
                        <DataGridCheckBoxColumn Header="{l:T en_jeu}" Binding="{Binding InGame}" Width="70" />
                        <DataGridTextColumn Header="{l:T id_gps}" Binding="{Binding GpsDeviceId}" Width="*" />
                        <DataGridTextColumn Header="{l:T compteur_depart}" Binding="{Binding OdometerStartText}" Width="*" />
                        <DataGridTextColumn Header="{l:T compteur_arrivee}" Binding="{Binding OdometerEndText}" Width="*" />
                        <DataGridTextColumn Header="{l:T km_sur_l_op}" Binding="{Binding KilometersText}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="{l:T remarques_immatriculation_places}" Binding="{Binding Notes}" Width="1.5*" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{l:T vehicule}" Command="{Binding AddVehicleCommand}" />
                    <Button Content="{l:T retirer_le_vehicule}" Command="{Binding RemoveVehicleCommand}" />
                </StackPanel>


                <TextBlock Classes="h2" Text="{l:T application_android}" Margin="0,8,0,0" />
                <StackPanel DataContext="{Binding Gps}" x:DataType="vm:GpsViewModel" Spacing="6">
                    <WrapPanel>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,12,4">
                            <Run Text="{l:T code_d_enrolement}" />
                            <Run Text="{Binding EnrollmentTeam.EnrollmentCodeText, FallbackValue='—'}" FontFamily="Consolas,monospace" FontWeight="Bold" FontSize="15" />
                        </TextBlock>
                        <Button Content="{l:T nouveau_code}" Command="{Binding GenerateCodeCommand}" Margin="0,0,6,4"
                                ToolTip.Tip="{l:T les_telephones_deja_enroles_restent_valides}" />
                        <Button Content="{l:T qr_code}" Command="{Binding ShowQrCodeCommand}" Margin="0,0,6,4"
                                ToolTip.Tip="{l:T a_scanner_avec_l_appareil_photo_du_telephone_du}" />
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding TeamDevices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:EnrolledDeviceRow">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="📱" />
                                        <Run Text="{Binding Device}" FontWeight="SemiBold" />
                                        <Run Text="{Binding LastSeen}" Foreground="Gray" />
                                    </TextBlock>
                                    <Button Content="{l:T revoquer}" Padding="6,1" FontSize="11" IsVisible="{Binding !IsRevoked}"
                                            Command="{Binding $parent[ItemsControl].((vm:GpsViewModel)DataContext).RevokeRowCommand}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                               Text="{l:T intervalle_d_envoi_ce_que_voient_les_telephones}" />
                </StackPanel>

                <TextBlock Text="{l:T notes}" Classes="label" />
                <TextBox Text="{Binding Selected.Notes, FallbackValue=''}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
