<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:l="using:AirsoftPlanner.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AirsoftPlanner.App.ViewModels"
             xmlns:retex="using:AirsoftPlanner.Core.Retex"
             x:Class="AirsoftPlanner.App.Views.RetexView"
             x:DataType="vm:RetexViewModel">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
            <TextBlock Text="{l:T retex_retour_d_experience}" Classes="h1" />
            <TextBlock Text="{Binding Status}" Opacity="0.8" />
            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" />
            <WrapPanel>
                <Button Content="{l:T actualiser}" Command="{Binding RefreshCommand}" Margin="0,0,8,4" />
                <Button Content="{l:T retex_global_pdf}" Command="{Binding GlobalPdfCommand}" Margin="0,0,8,4" Classes="accent"
                        ToolTip.Tip="{l:T bilan_de_toutes_les_equipes_chronologie_complete}" />
                <Button Content="{l:T retex_de_l_equipe_pdf}" Command="{Binding TeamPdfCommand}" Margin="0,0,8,4"
                        ToolTip.Tip="{l:T missions_prevues_diffusees_terminees_trajet_mess}" />
                <Button Content="{l:T tous_les_retex_d_equipe_pdf}" Command="{Binding AllTeamsPdfCommand}" Margin="0,0,8,4" />
            </WrapPanel>
        </StackPanel>
        <Grid RowDefinitions="Auto,*,Auto,2*">
            <TextBlock Text="{l:T bilan_par_equipe_selectionnez_une_equipe_pour_vo}" FontWeight="SemiBold" Margin="0,0,0,4" />
            <DataGrid Grid.Row="1" ItemsSource="{Binding Teams}" SelectedItem="{Binding SelectedTeam}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:T equipe}" Binding="{Binding Team}" Width="1.4*" />
                    <DataGridTextColumn Header="{l:T faction}" Binding="{Binding Faction}" Width="*" />
                    <DataGridTextColumn Header="{l:T missions_diffusees}" Binding="{Binding Missions}" Width="*" />
                    <DataGridTextColumn Header="{l:T terminees}" Binding="{Binding Completed}" Width="*" />
                    <DataGridTextColumn Header="{l:T retard_moyen_de_diffusion}" Binding="{Binding AverageDelay}" Width="1.3*" />
                    <DataGridTextColumn Header="{l:T distance}" Binding="{Binding Distance}" Width="*" />
                    <DataGridTextColumn Header="{l:T sorties_de_jeu}" Binding="{Binding PlayersOut}" Width="*" />
                    <DataGridTextColumn Header="{l:T messages_recus}" Binding="{Binding Messages}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="2" Text="{l:T chronologie}" FontWeight="SemiBold" Margin="0,12,0,4" />
            <DataGrid Grid.Row="3" ItemsSource="{Binding Timeline}" AutoGenerateColumns="False" IsReadOnly="True"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="1"
                      BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:T heure}" Binding="{Binding Time}" Width="110" />
                    <DataGridTextColumn Header="{l:T equipe}" Binding="{Binding Team}" Width="140" />
                    <DataGridTextColumn Header="{l:T type}" Binding="{Binding Category}" Width="150" />
                    <DataGridTextColumn Header="{l:T detail}" Binding="{Binding Text}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
