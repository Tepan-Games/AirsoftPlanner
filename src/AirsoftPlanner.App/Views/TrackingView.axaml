<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AirsoftPlanner.App.ViewModels"
             xmlns:conv="using:AirsoftPlanner.App.Converters"
             xmlns:controls="using:AirsoftPlanner.App.Controls"
             xmlns:views="using:AirsoftPlanner.App.Views"
             x:Class="AirsoftPlanner.App.Views.TrackingView"
             x:DataType="vm:TrackingViewModel">
    <DockPanel>
        <!-- Horloge : heure réelle ou simulation -->
        <Border DockPanel.Dock="Top" Padding="10,6" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <RadioButton Content="Heure réelle" IsChecked="{Binding !IsSimulation}" GroupName="clock" />
                    <RadioButton Content="Simulation" IsChecked="{Binding IsSimulation}" GroupName="clock" />
                    <Slider Minimum="{Binding SimulationStart}" Maximum="{Binding SimulationEnd}" Value="{Binding SimulatedMinutes}"
                            SmallChange="5" LargeChange="30" TickFrequency="5" IsSnapToTickEnabled="True" Width="260"
                            IsEnabled="{Binding IsSimulation}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding NowText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding Summary}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
            </DockPanel>
        </Border>

        <!-- Plan radio, toujours visible -->
        <Border DockPanel.Dock="Top" Padding="10,4" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="📻 Plan radio" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ItemsControl ItemsSource="{Binding RadioPlan}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RadioFaction">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,20,2">
                                <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center"
                                        Background="{Binding Color, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                                <TextBlock VerticalAlignment="Center">
                                    <Run Text="{Binding Name}" FontWeight="SemiBold" />
                                    <Run Text="{Binding Frequency}" FontWeight="SemiBold"
                                         Foreground="{Binding Color, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Teams}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="10" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RadioTeam">
                                            <TextBlock>
                                                <Run Text="{Binding Name}" />
                                                <Run Text="{Binding IsCommand, Converter={x:Static conv:BoolToTextConverter.CommandStar}}" />
                                                <Run Text="{Binding Frequency}" FontFamily="Consolas,monospace" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Grid ColumnDefinitions="*,6,*">
            <DockPanel>
            <views:DelayPanel DockPanel.Dock="Bottom" DataContext="{Binding Missions.Delay}" IsVisible="{Binding IsOpen}" />
            <controls:TimelineControl Columns="{Binding Missions.Columns}"
                                      Missions="{Binding Missions.Missions}"
                                      SelectedMission="{Binding Missions.Selected}"
                                      OperationStart="{Binding Missions.OperationStartMinutes}"
                                      OperationEnd="{Binding Missions.OperationEndMinutes}"
                                      Day="{Binding Missions.Operation.Day}"
                                      NowMinutes="{Binding NowMinutes}"
                                      FollowNow="True" />
            </DockPanel>
            <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

            <Grid Grid.Column="2" RowDefinitions="*,6,280">
                <DockPanel>
                <Border DockPanel.Dock="Top" Padding="8,3">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <CheckBox Content="Trajets des équipes" IsChecked="{Binding ShowTrails}" />
                        <CheckBox Content="Quadrillage UTM" IsChecked="{Binding Terrain.ShowUtmGrid}" />
                    </StackPanel>
                </Border>
                <controls:TerrainMapControl Layer="{Binding Terrain.SelectedLayer}"
                                            ViewBounds="{Binding Terrain.ViewBounds}"
                                            Area="{Binding Terrain.Area}"
                                            Zones="{Binding Terrain.Zones}"
                                            ShowUtmGrid="{Binding Terrain.ShowUtmGrid}"
                                            Markers="{Binding Markers}"
                                            AllowEditing="False"
                                            Trails="{Binding Trails}"
                                            ItemMarkers="{Binding ItemMarkers}"
                                            IsDrawing="{Binding IsMapPlacing}"
                                            MapClickCommand="{Binding MapClickedCommand}" />
                </DockPanel>
                <GridSplitter Grid.Row="1" ResizeDirection="Rows" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

                <TabControl Grid.Row="2" Padding="0">
                <TabItem Header="Équipes">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ToggleButton Content="Placer l'équipe sur la carte" IsChecked="{Binding IsPlacing}"
                                          IsEnabled="{Binding HasSelection}" />
                            <TextBox Text="{Binding PositionInput}" Width="220" PlaceholderText="ou coordonnées reçues (UTM, degrés…)" />
                            <Button Content="Enregistrer la position" Command="{Binding SetPositionCommand}" />
                            <Button Content="Gérer le retard…" Command="{Binding PlanDelayCommand}"
                                    ToolTip.Tip="Répercuter le retard estimé de l'équipe sur la suite du planning" />
                        </StackPanel>
                    </Border>
                    <ListBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Selected}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TeamStatusViewModel">
                                <Grid ColumnDefinitions="Auto,150,*">
                                    <Border Width="12" Height="12" CornerRadius="6" Margin="0,4,10,0" VerticalAlignment="Top"
                                            Background="{Binding StatusColor, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Team.Name}" FontWeight="SemiBold" />
                                        <TextBlock FontSize="11" FontFamily="Consolas,monospace" Text="{Binding Team.RadioFrequencyLabel}" />
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="11"
                                                   Foreground="{Binding StatusColor, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding MissionText}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DistanceText}" FontSize="11" Opacity="0.8" />
                                        <TextBlock Text="{Binding PositionText}" FontSize="11" Opacity="0.6" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                </TabItem>
                <TabItem Header="Objets d'objectif">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="8,4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox ItemsSource="{Binding ItemEventOptions}" SelectedItem="{Binding SelectedItemEvent}" MinWidth="170" />
                                <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding ItemEventTeam}" MinWidth="140"
                                          IsVisible="{Binding ItemEventNeedsTeam}" PlaceholderText="Équipe…">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TeamStatusViewModel">
                                            <TextBlock Text="{Binding Team.Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Content="Enregistrer" Command="{Binding RecordItemEventCommand}"
                                        ToolTip.Tip="« Placé » et « Déposé » demandent ensuite un clic sur la carte" />
                                <TextBlock Text="→ cliquez sur la carte" IsVisible="{Binding IsPlacingItem}" Foreground="#EF6C00"
                                           VerticalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <TextBlock DockPanel.Dock="Top" IsVisible="{Binding !TrackedItems.Count}" Margin="10" Opacity="0.65" TextWrapping="Wrap"
                                   Text="Aucun objet suivi : cochez « Objet d'objectif à suivre » sur les éléments concernés dans l'onglet Matériel de jeu." />
                        <ListBox ItemsSource="{Binding TrackedItems}" SelectedItem="{Binding SelectedItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:TrackedItemViewModel">
                                    <Grid ColumnDefinitions="Auto,200,*">
                                        <Border Width="12" Height="12" CornerRadius="2" Margin="0,4,10,0" VerticalAlignment="Top"
                                                Background="{Binding StateColor, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Item.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding StateText}" FontSize="11"
                                                       Foreground="{Binding StateColor, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding LocationText}" FontSize="11" FontWeight="SemiBold" />
                                            <ItemsControl ItemsSource="{Binding History}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <TextBlock Text="{Binding}" FontSize="11" Opacity="0.65" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
