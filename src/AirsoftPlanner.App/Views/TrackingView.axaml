<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:l="using:AirsoftPlanner.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AirsoftPlanner.App.ViewModels"
             xmlns:conv="using:AirsoftPlanner.App.Converters"
             xmlns:controls="using:AirsoftPlanner.App.Controls"
             xmlns:views="using:AirsoftPlanner.App.Views"
             x:Class="AirsoftPlanner.App.Views.TrackingView"
             x:DataType="vm:TrackingViewModel">
    <DockPanel>
        <!-- Horloge : heure réelle ou simulation -->
        <Border DockPanel.Dock="Top" Padding="10,6" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <RadioButton Content="{l:T heure_reelle}" IsChecked="{Binding !IsSimulation}" GroupName="clock" />
                    <RadioButton Content="{l:T simulation}" IsChecked="{Binding IsSimulation}" GroupName="clock" />
                    <Slider Minimum="{Binding SimulationStart}" Maximum="{Binding SimulationEnd}" Value="{Binding SimulatedMinutes}"
                            SmallChange="5" LargeChange="30" Width="260"
                            IsEnabled="{Binding IsSimulation}" VerticalAlignment="Center" />
                    <!-- Lecture de l'OP enregistrée : retour, pause, lecture, sauts de 5 min, vitesse -->
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button Content="⏮" Command="{Binding StepCommand}" CommandParameter="-5" ToolTip.Tip="{l:T 5_minutes_en_arriere}" Padding="6,2" />
                        <Button Content="⏪" Command="{Binding PlayBackwardCommand}" ToolTip.Tip="{l:T retour_lecture_a_l_envers}" Padding="6,2" />
                        <Button Content="⏸" Command="{Binding PausePlaybackCommand}" ToolTip.Tip="{l:T pause}" Padding="6,2" IsEnabled="{Binding IsPlaying}" />
                        <Button Content="▶" Command="{Binding PlayForwardCommand}" ToolTip.Tip="{l:T lecture_avance_rapide_selon_la_vitesse_choisie}" Padding="6,2" />
                        <Button Content="⏭" Command="{Binding StepCommand}" CommandParameter="5" ToolTip.Tip="{l:T 5_minutes_en_avant}" Padding="6,2" />
                        <ComboBox ItemsSource="{Binding PlaybackSpeeds}" SelectedItem="{Binding PlaybackSpeed}" MinWidth="130" Margin="4,0,0,0"
                                  ToolTip.Tip="{l:T vitesse_de_lecture}" />
                    </StackPanel>
                    <TextBlock Text="{Binding NowText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <Button Content="{Binding Gps.ServerStatus, FallbackValue='📡'}" Click="OnSettingsClick"
                            ToolTip.Tip="{l:T parametres_du_suivi_serveur_local_second_poste_m}" />
                    <Button Content="{l:T mode_eclate}" Click="OnExplodeClick"
                            ToolTip.Tip="{l:T carte_frise_et_etat_des_equipes_dans_des_fenetre}" />
                    <Button Content="{l:T tout_rattacher}" Click="OnReattachClick" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Plan radio, toujours visible -->
        <Border DockPanel.Dock="Top" Padding="10,4" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{l:T plan_radio}" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,2,12,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="12,0,0,0">
                    <TextBlock Text="{Binding OrgaContact}" FontWeight="SemiBold" Foreground="#C62828" VerticalAlignment="Center" />
                    <ToggleButton IsChecked="{Binding IsRadioPlanExpanded}" Padding="6,1" FontSize="11"
                                  ToolTip.Tip="{l:T replier_le_plan_radio_sur_quelques_lignes_defile}">
                        <Panel>
                            <TextBlock Text="{l:T tout_afficher_2}" IsVisible="{Binding !IsRadioPlanExpanded}" />
                            <TextBlock Text="{l:T replier}" IsVisible="{Binding IsRadioPlanExpanded}" />
                        </Panel>
                    </ToggleButton>
                </StackPanel>
                <!-- Une ligne par faction, ses équipes passent à la ligne : lisible même avec une vingtaine d'équipes -->
                <ScrollViewer MaxHeight="{Binding RadioPlanMaxHeight}" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding RadioPlan}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RadioFaction">
                                <DockPanel Margin="0,1">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6" MinWidth="190" VerticalAlignment="Top" Margin="0,0,14,0">
                                        <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center"
                                                Background="{Binding Color, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                                        <TextBlock VerticalAlignment="Center">
                                            <Run Text="{Binding Name}" FontWeight="SemiBold" />
                                            <Run Text="{Binding Frequency}" FontWeight="SemiBold"
                                                 Foreground="{Binding Color, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                                            <Run Text="{Binding IsDuplicate, Converter={x:Static conv:BoolToTextConverter.DuplicateWarning}}"
                                                 Foreground="#E65100" FontWeight="Bold" />
                                        </TextBlock>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Teams}" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RadioTeam">
                                                <Border Padding="4,0" Margin="0,0,10,0" CornerRadius="3"
                                                        Classes.duplicate="{Binding IsDuplicate}"
                                                        ToolTip.Tip="{Binding IsDuplicate, Converter={x:Static conv:BoolToTextConverter.DuplicateFrequencyTip}}">
                                                    <Border.Styles>
                                                        <Style Selector="Border.duplicate">
                                                            <Setter Property="Background" Value="#33E65100" />
                                                        </Style>
                                                    </Border.Styles>
                                                    <TextBlock>
                                                        <Run Text="{Binding Name}" />
                                                        <Run Text="{Binding IsCommand, Converter={x:Static conv:BoolToTextConverter.CommandStar}}" />
                                                        <Run Text="{Binding Frequency}" FontFamily="Consolas,monospace" />
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Diffusion des missions : questions posées à l'orga (rien n'est envoyé automatiquement) -->
        <Border DockPanel.Dock="Top" Padding="10,4" BorderThickness="0,0,0,1" BorderBrush="#1565C0" Background="#261565C0"
                IsVisible="{Binding Dispatch.HasPrompts, FallbackValue=False}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{l:T a_diffuser}" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,3,12,0" />
                <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Dispatch.Prompts, FallbackValue={x:Null}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DiffusionPromptViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1">
                                    <TextBlock Text="{Binding Question}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="820" />
                                    <Button Content="{Binding AcceptLabel}" Padding="8,1" Classes="accent"
                                            Command="{Binding $parent[ItemsControl].((vm:TrackingViewModel)DataContext).Dispatch.AcceptCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="{l:T terminer_seulement}" Padding="8,1" IsVisible="{Binding CanEndOnly}"
                                            Command="{Binding $parent[ItemsControl].((vm:TrackingViewModel)DataContext).Dispatch.EndOnlyCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="{l:T plus_tard}" Padding="8,1"
                                            ToolTip.Tip="{l:T la_question_reviendra_dans_10_minutes}"
                                            Command="{Binding $parent[ItemsControl].((vm:TrackingViewModel)DataContext).Dispatch.LaterCommand}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>


        <Grid ColumnDefinitions="*,6,*">
            <controls:DetachableHost x:Name="TimelineHost" Title="{l:T frise}">
                <controls:DetachableHost.Panel>
                    <views:TrackingTimelinePanel />
                </controls:DetachableHost.Panel>
            </controls:DetachableHost>
            <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

            <Grid Grid.Column="2" RowDefinitions="*,6,280">
                <controls:DetachableHost x:Name="MapHost" Title="{l:T carte}">
                    <controls:DetachableHost.Panel>
                        <views:TrackingMapPanel />
                    </controls:DetachableHost.Panel>
                </controls:DetachableHost>
                <GridSplitter Grid.Row="1" ResizeDirection="Rows" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                <controls:DetachableHost x:Name="StatusHost" Grid.Row="2" Title="{l:T etat_des_equipes}">
                    <controls:DetachableHost.Panel>
                        <views:TrackingStatusPanel />
                    </controls:DetachableHost.Panel>
                </controls:DetachableHost>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
