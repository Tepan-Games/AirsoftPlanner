<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:l="using:AirsoftPlanner.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AirsoftPlanner.App.ViewModels"
             xmlns:app="using:AirsoftPlanner.App"
             xmlns:conv="using:AirsoftPlanner.App.Converters"
             xmlns:controls="using:AirsoftPlanner.App.Controls"
             xmlns:sys="using:System"
             x:Class="AirsoftPlanner.App.Views.TerrainView"
             x:DataType="vm:TerrainViewModel">
    <Grid ColumnDefinitions="340,*">
        <ScrollViewer>
            <StackPanel Margin="12" Spacing="8">

                <!-- Emprise -->
                <TextBlock Text="{l:T emprise_du_terrain}" Classes="h2" />
                <TextBlock Text="{l:T centre_copie_depuis_google_maps_geoportail_un_gp}" Classes="label" TextWrapping="Wrap" />
                <TextBox Text="{Binding CenterText}" PlaceholderText="{l:T ex_31t_448251_5411952_ou_48_8583_2_2944}" />
                <WrapPanel ItemSpacing="8" LineSpacing="6">
                    <NumericUpDown Value="{Binding AreaSizeKm}" Minimum="0.1" Maximum="20" Increment="0.5"
                                   FormatString="0.0" Width="130" />
                    <TextBlock Text="{l:T km_de_cote}" VerticalAlignment="Center" />
                    <Button Content="{l:T appliquer}" Command="{Binding ApplyCenterCommand}" />
                </WrapPanel>
                <Expander Header="{l:T ou_saisir_les_deux_coins}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{l:T coin_nord_ouest}" Classes="label" />
                        <TextBox Text="{Binding NorthWestText}" />
                        <TextBlock Text="{l:T coin_sud_est}" Classes="label" />
                        <TextBox Text="{Binding SouthEastText}" />
                    </StackPanel>
                </Expander>
                <TextBlock Text="{Binding AreaSummary}" TextWrapping="Wrap" Opacity="0.75" />

                <!-- Fonds de carte -->
                <TextBlock Text="{l:T fonds_de_carte}" Classes="h2" Margin="0,12,0,0" />
                <TextBlock Text="{l:T telecharges_une_fois_connexion_internet_necessai}"
                           TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
                <ListBox ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}" MaxHeight="160">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:MapLayerViewModel">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="{Binding Details}" FontSize="11" Opacity="0.6" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" MinWidth="190" />
                    <Button Content="{l:T telecharger}" Command="{Binding DownloadCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding DownloadSummary}" FontSize="12" Opacity="0.7" />
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsDownloading}">
                    <ProgressBar Value="{Binding DownloadProgress}" Width="220" ShowProgressText="True" />
                    <Button Content="{l:T annuler}" Command="{Binding CancelDownloadCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{l:T importer_une_image}" Command="{Binding ImportImageCommand}"
                            ToolTip.Tip="{l:T image_orientee_nord_en_haut_couvrant_exactement}" />
                    <Button Content="🗑" Classes="icon" Command="{Binding RemoveLayerCommand}" ToolTip.Tip="{l:T supprimer_le_fond}" AutomationProperties.Name="{l:T supprimer_le_fond}" />
                </StackPanel>

                <!-- Zones -->
                <TextBlock Text="{l:T zones_et_points}" Classes="h2" Margin="0,12,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{l:T zone_2}" Command="{Binding AddAreaCommand}" ToolTip.Tip="{l:T surface_base_secteur_zone_interdite}" />
                    <Button Content="{l:T point}" Command="{Binding AddPointCommand}" ToolTip.Tip="{l:T objectif_caisse_respawn}" />
                    <Button Content="🗑" Classes="icon" ToolTip.Tip="{l:T supprimer}" AutomationProperties.Name="{l:T supprimer}" Command="{Binding RemoveZoneCommand}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Zones}" SelectedItem="{Binding SelectedZone}" MaxHeight="220">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ZoneViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <controls:SymbolView Symbol="{Binding ResolvedSymbol}" Color="{Binding SymbolColor}" Width="30" Height="22" />
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" />
                                    <TextBlock Text="{Binding Summary}" FontSize="11" Opacity="0.6" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel IsVisible="{Binding HasSelectedZone}" Spacing="6">
                    <TextBlock Text="{l:T nom}" Classes="label" />
                    <TextBox Text="{Binding SelectedZone.Name, FallbackValue=''}" />
                    <TextBlock Text="{l:T categorie}" Classes="label" />
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedZone.Category, FallbackValue={x:Null}}" MinWidth="240" />
                    <TextBlock Text="{l:T symbole_militaire}" Classes="label" />
                    <ComboBox ItemsSource="{Binding Symbols}" SelectedItem="{Binding SelectedZone.Symbol, FallbackValue={x:Null}}" MinWidth="240">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:MilSymbolOption">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <controls:SymbolView Symbol="{Binding Value}" Width="40" Height="28" />
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <WrapPanel ItemSpacing="8" LineSpacing="6">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{l:T faction_couleur_du_symbole}" Classes="label" />
                            <ComboBox ItemsSource="{Binding OwnerOptions}" SelectedItem="{Binding SelectedZoneOwner}" MinWidth="150" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{l:T taille_d_unite}" Classes="label" />
                            <ComboBox ItemsSource="{Binding Echelons}" SelectedItem="{Binding SelectedZone.Echelon, FallbackValue={x:Null}}" MinWidth="120" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{l:T visible_par_telephones_des_equipes_ordres_de_mis}" Classes="label" />
                    <ComboBox ItemsSource="{Binding VisibilityOptions}" SelectedItem="{Binding SelectedZoneVisibility}" MinWidth="240"
                              ToolTip.Tip="{l:T bivouac_d_une_faction_campement_respawn_affiche}" />
                    <ComboBox ItemsSource="{Binding Missions}" SelectedItem="{Binding SelectedZoneMission}" MinWidth="240"
                              IsVisible="{Binding IsMissionVisibility}" PlaceholderText="{l:T mission_3}"
                              ToolTip.Tip="{l:T le_point_n_est_envoye_aux_telephones_des_equipes}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:MissionViewModel">
                                <TextBlock>
                                    <Run Text="{Binding StartText}" FontWeight="SemiBold" />
                                    <Run Text="{Binding Name}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{l:T couleur}" Classes="label" />
                    <ComboBox ItemsSource="{x:Static app:ColorPalette.Colors}" SelectedItem="{Binding SelectedZone.Color, FallbackValue={x:Null}}" Width="120">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="sys:String">
                                <Border Width="70" Height="18" CornerRadius="3" BorderBrush="Gray" BorderThickness="1"
                                        Background="{Binding Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel IsVisible="{Binding !SelectedZone.IsArea, FallbackValue=False}" Spacing="6">
                        <TextBlock Text="{l:T position_tous_formats_acceptes}" Classes="label" />
                        <TextBox Text="{Binding SelectedZone.PositionText, FallbackValue=''}" />
                    </StackPanel>
                    <TextBlock Text="{l:T description_consignes}" Classes="label" />
                    <TextBox Text="{Binding SelectedZone.Description, FallbackValue=''}" AcceptsReturn="True"
                             TextWrapping="Wrap" MinHeight="70" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleButton Content="{l:T placer_sur_la_carte}" IsChecked="{Binding IsDrawing}" />
                        <Button Content="↶" Classes="icon" Command="{Binding UndoPointCommand}" ToolTip.Tip="{l:T annuler_sommet}"
                                AutomationProperties.Name="{l:T annuler_sommet}" IsVisible="{Binding SelectedZone.IsArea, FallbackValue=False}" />
                        <Button Content="⌫" Classes="icon" Command="{Binding ClearPointsCommand}" ToolTip.Tip="{l:T effacer}" AutomationProperties.Name="{l:T effacer}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Padding="10,6" BorderThickness="1,0,0,1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <CheckBox Content="{l:T quadrillage}" ToolTip.Tip="{l:T quadrillage_dans_le_format_de_coordonnees_choisi}" IsChecked="{Binding ShowUtmGrid}" />
                        <Button Content="{l:T vue_d_ensemble}" Click="OnResetViewClick" />
                    </StackPanel>
                    <TextBlock Text="{Binding PointerText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontFamily="Consolas,monospace" />
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Bottom" Padding="10,4" IsVisible="{Binding IsDrawing}" Background="#FFF3E0">
                <TextBlock Foreground="#E65100" Text="{l:T mode_placement_cliquez_sur_la_carte_pour_placer}" TextWrapping="Wrap" />
            </Border>
            <controls:TerrainMapControl x:Name="Map"
                                        ViewBounds="{Binding ViewBounds}"
                                        Layer="{Binding SelectedLayer}"
                                        Area="{Binding Area}"
                                        Zones="{Binding Zones}"
                                        SelectedZone="{Binding SelectedZone}"
                                        IsDrawing="{Binding IsDrawing}"
                                        ShowUtmGrid="{Binding ShowUtmGrid}"
                                        PointerPosition="{Binding PointerPosition}"
                                        MapClickCommand="{Binding MapClickedCommand}" />
        </DockPanel>
    </Grid>
</UserControl>
