<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:l="using:AirsoftPlanner.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AirsoftPlanner.App.ViewModels"
             xmlns:conv="using:AirsoftPlanner.App.Converters"
             xmlns:controls="using:AirsoftPlanner.App.Controls"
             xmlns:views="using:AirsoftPlanner.App.Views"
             x:Class="AirsoftPlanner.App.Views.MissionsView"
             x:DataType="vm:MissionsViewModel">
    <Grid ColumnDefinitions="3*,6,2*,360">
        <DockPanel>
            <Border DockPanel.Dock="Top" Padding="10,6" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="{l:T mission}" Command="{Binding AddCommand}" />
                        <Button Content="❐" Classes="icon" ToolTip.Tip="{l:T dupliquer}" AutomationProperties.Name="{l:T dupliquer}" Command="{Binding DuplicateCommand}" />
                        <Button Content="🗑" Classes="icon" ToolTip.Tip="{l:T supprimer}" AutomationProperties.Name="{l:T supprimer}" Command="{Binding RemoveCommand}" />
                        <Button Content="⛶" Classes="icon" Click="OnFitClick" ToolTip.Tip="{l:T tout_afficher}" AutomationProperties.Name="{l:T tout_afficher}" />
                        <Button Content="⏱" Classes="icon" Command="{Binding OpenDelayCommand}" AutomationProperties.Name="{l:T gerer_un_retard}">
                            <ToolTip.Tip>
                                <TextBlock><Run Text="{l:T gerer_un_retard}" FontWeight="SemiBold" /><LineBreak /><Run Text="{l:T repercuter_le_retard_de_la_mission_selectionnee}" /></TextBlock>
                            </ToolTip.Tip>
                        </Button>
                        <Button Content="↶" Classes="icon" Command="{Binding Delay.UndoCommand}" AutomationProperties.Name="{l:T annuler_le_dernier_decalage}">
                            <ToolTip.Tip>
                                <TextBlock><Run Text="{l:T annuler_le_dernier_decalage}" FontWeight="SemiBold" /><LineBreak /><Run Text="{Binding Delay.LastApplied}" /></TextBlock>
                            </ToolTip.Tip>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding IssueSummary}" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                </DockPanel>
            </Border>
            <views:DelayPanel DockPanel.Dock="Bottom" DataContext="{Binding Delay}" IsVisible="{Binding IsOpen}" />
            <TextBlock DockPanel.Dock="Bottom" Margin="10,4" FontSize="11" Opacity="0.65" TextWrapping="Wrap"
                       Text="{l:T double_clic_nouvelle_mission_glisser_deplacer_ou}" />
            <controls:TimelineControl x:Name="Timeline"
                                      Columns="{Binding Columns}"
                                      Missions="{Binding Missions}"
                                      SelectedMission="{Binding Selected}"
                                      OperationStart="{Binding OperationStartMinutes}"
                                      OperationEnd="{Binding OperationEndMinutes}"
                                      Day="{Binding Operation.Day}"
                                      CreateCommand="{Binding CreateAtCommand}" />
        </DockPanel>

        <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

        <!-- Carte toujours visible : terrain, points d'intérêt, matériel des missions, zone de la mission sélectionnée -->
        <controls:DetachableHost Grid.Column="2" Title="{l:T carte_de_l_organisation}">
            <controls:DetachableHost.Panel>
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="8,3">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <CheckBox Content="{l:T quadrillage}" IsChecked="{Binding Terrain.ShowUtmGrid}" />
                            <TextBlock VerticalAlignment="Center" FontSize="12" Opacity="0.8" IsVisible="{Binding HasSelection}">
                                <Run Text="{l:T zone_de_la_mission}" />
                                <Run Text="{Binding Selected.ZoneName, FallbackValue=''}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <controls:TerrainMapControl Layer="{Binding Terrain.SelectedLayer}"
                                                ViewBounds="{Binding Terrain.ViewBounds}"
                                                Area="{Binding Terrain.Area}"
                                                Zones="{Binding Terrain.Zones}"
                                                SelectedZone="{Binding Selected.Zone, Mode=OneWay, FallbackValue={x:Null}}"
                                                ShowUtmGrid="{Binding Terrain.ShowUtmGrid}"
                                                ItemMarkers="{Binding PlanMarkers}"
                                                AllowEditing="False" />
                </DockPanel>
            </controls:DetachableHost.Panel>
        </controls:DetachableHost>

        <Border Grid.Column="3" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <Panel>
                <TextBlock IsVisible="{Binding !HasSelection}" Margin="16" TextWrapping="Wrap" Opacity="0.7"
                           Text="{l:T selectionnez_une_mission_sur_la_frise_ou_double}" />
                <ScrollViewer IsVisible="{Binding HasSelection}">
                    <StackPanel Margin="14" Spacing="8">
                        <TextBlock Text="{l:T mission_2}" Classes="h1" />
                        <Border IsVisible="{Binding Selected.HasIssues, FallbackValue=False}" Background="#FFEBEE"
                                CornerRadius="4" Padding="8">
                            <TextBlock Text="{Binding Selected.IssuesText, FallbackValue=''}" Foreground="#B71C1C"
                                       TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Text="{l:T nom}" Classes="label" />
                        <TextBox Text="{Binding Selected.Name, FallbackValue=''}" />

                        <Grid ColumnDefinitions="*,12,*">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{l:T debut}" Classes="label" />
                                <TextBox Text="{Binding Selected.StartText, FallbackValue=''}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="10">
                                <TextBlock Text="{l:T duree_min}" Classes="label" />
                                <NumericUpDown Value="{Binding Selected.DurationMinutes, FallbackValue=30}" Minimum="5"
                                               Maximum="1440" Increment="5" FormatString="0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding Selected.TimeRangeText, FallbackValue=''}" FontSize="12" Opacity="0.7" />

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox Content="{l:T essentielle}" IsChecked="{Binding Selected.IsEssential, FallbackValue=True}"
                                      ToolTip.Tip="{l:T une_mission_non_essentielle_peut_etre_desactivee}" />
                            <CheckBox Content="{l:T activee}" IsChecked="{Binding Selected.IsEnabled, FallbackValue=True}" />
                        </StackPanel>

                        <TextBlock Text="{l:T zone}" Classes="label" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox ItemsSource="{Binding Zones}" SelectedItem="{Binding Selected.Zone, FallbackValue={x:Null}}"
                                      PlaceholderText="{l:T aucune_zone}" MinWidth="230">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ZoneViewModel">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Width="14" Height="14" CornerRadius="3"
                                                    Background="{Binding Color, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                                            <TextBlock Text="{Binding Name}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="✕" Classes="icon" ToolTip.Tip="{l:T retirer}" AutomationProperties.Name="{l:T retirer}" Command="{Binding ClearZoneCommand}" />
                        </StackPanel>

                        <TextBlock IsVisible="{Binding Selected.HasMissionPoints, FallbackValue=False}" TextWrapping="Wrap" FontSize="12"
                                   ToolTip.Tip="{l:T points_dont_la_visibilite_est_pendant_une_missio}">
                            <Run Text="{l:T points_diffuses_avec_la_mission}" FontWeight="SemiBold" />
                            <Run Text="{Binding Selected.MissionPoints, FallbackValue=''}" />
                        </TextBlock>
                        <TextBlock Text="{l:T equipes}" Classes="label" />
                        <ItemsControl ItemsSource="{Binding TeamChoices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TeamChoiceViewModel">
                                    <CheckBox IsChecked="{Binding IsSelected}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Width="10" Height="10" CornerRadius="5"
                                                    Background="{Binding Team.Faction.Color, FallbackValue={x:Null}, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                                            <TextBlock Text="{Binding Team.Name}" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding Selected.PlayersText, FallbackValue=''}" FontSize="12" Opacity="0.75" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <CheckBox Content="{l:T effectif_maximum}" IsChecked="{Binding Selected.HasMaxPlayers, FallbackValue=False}" />
                            <NumericUpDown Value="{Binding Selected.MaxPlayers, FallbackValue={x:Null}}" Minimum="1" Maximum="5000"
                                           Increment="1" FormatString="0" Width="130"
                                           IsEnabled="{Binding Selected.HasMaxPlayers, FallbackValue=False}" />
                        </StackPanel>

                        <TextBlock Text="{l:T materiel_de_jeu_utilise}" Classes="label" />
                        <ItemsControl ItemsSource="{Binding Selected.ItemUses, FallbackValue={x:Null}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MissionItemUseViewModel">
                                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                                        <TextBlock Text="{Binding Item.Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <NumericUpDown Grid.Column="1" Value="{Binding Quantity}" Minimum="1" Maximum="1000"
                                                       Increment="1" FormatString="0" Width="110" Margin="6,0" />
                                        <Button Grid.Column="2" Content="✕" ToolTip.Tip="{l:T retirer_de_la_mission}"
                                                Command="{Binding $parent[UserControl].((vm:MissionsViewModel)DataContext).RemoveItemCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <ComboBox ItemsSource="{Binding GameItems}" SelectedItem="{Binding ItemToAdd}"
                                      PlaceholderText="{l:T choisir_un_element}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GameItemViewModel">
                                        <TextBlock>
                                            <Run Text="{Binding Name}" />
                                            <Run Text="(" FontSize="11" /><Run Text="{l:T stock}" FontSize="11" />
                                            <Run Text="{Binding Quantity}" FontSize="11" /><Run Text=")" FontSize="11" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <NumericUpDown Grid.Column="1" Value="{Binding ItemToAddQuantity}" Minimum="1" Maximum="1000"
                                           Increment="1" FormatString="0" Width="110" Margin="6,0" />
                            <Button Grid.Column="2" Content="{l:T ajouter}" Command="{Binding AddItemCommand}" />
                        </Grid>

                        <TextBlock Text="{l:T prerequis_missions_a_terminer_avant}" Classes="label" />
                        <TextBlock IsVisible="{Binding !PredecessorChoices.Count}" Text="{l:T aucune_autre_mission}" FontSize="12" Opacity="0.6" />
                        <ItemsControl ItemsSource="{Binding PredecessorChoices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PredecessorChoiceViewModel">
                                    <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}">
                                        <TextBlock>
                                            <Run Text="{Binding Mission.StartText}" FontWeight="SemiBold" />
                                            <Run Text="{Binding Mission.Name}" />
                                        </TextBlock>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{l:T condition_jouee_selon_le_resultat}" Classes="label" />
                        <StackPanel Spacing="6">
                            <ComboBox ItemsSource="{x:Static vm:MissionConditionOption.All}" SelectedItem="{Binding Selected.Condition, FallbackValue={x:Null}}"
                                      MinWidth="160" ToolTip.Tip="{l:T condition_aide}" />
                            <ComboBox ItemsSource="{Binding ConditionChoices}" SelectedItem="{Binding Selected.ConditionMission, FallbackValue={x:Null}}"
                                      IsEnabled="{Binding Selected.HasCondition, FallbackValue=False}" PlaceholderText="{l:T choisir_la_mission}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MissionViewModel">
                                        <TextBlock>
                                            <Run Text="{Binding StartText}" FontWeight="SemiBold" />
                                            <Run Text="{Binding Name}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Text="{l:T resultat_et_points}" Classes="h2" Margin="0,8,0,0" />
                        <ComboBox ItemsSource="{x:Static vm:MissionResultOption.All}" SelectedItem="{Binding Selected.Result, FallbackValue={x:Null}}" MinWidth="200" />
                        <TextBox Text="{Binding Selected.ResultNotes, FallbackValue=''}" PlaceholderText="{l:T commentaire_sur_le_resultat}" AcceptsReturn="True" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,8,*,8,*">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{l:T resultat_reussie}" FontSize="12" />
                                <NumericUpDown Value="{Binding Selected.SuccessPoints, FallbackValue=10}" Minimum="-1000" Maximum="1000" Increment="1" FormatString="0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="{l:T resultat_partielle}" FontSize="12" />
                                <NumericUpDown Value="{Binding Selected.PartialPoints, FallbackValue=5}" Minimum="-1000" Maximum="1000" Increment="1" FormatString="0" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" Spacing="4">
                                <TextBlock Text="{l:T resultat_echouee}" FontSize="12" />
                                <NumericUpDown Value="{Binding Selected.FailurePoints, FallbackValue=0}" Minimum="-1000" Maximum="1000" Increment="1" FormatString="0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{l:T points_aide}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />

                        <TextBlock Text="{l:T briefing_objectif_consignes_conditions_de_reussi}" Classes="label" />
                        <TextBox Text="{Binding Selected.Description, FallbackValue=''}" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="140" />
                    </StackPanel>
                </ScrollViewer>
            </Panel>
        </Border>
    </Grid>
</UserControl>
