<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AirsoftPlanner.App.ViewModels"
             xmlns:conv="using:AirsoftPlanner.App.Converters"
             xmlns:controls="using:AirsoftPlanner.App.Controls"
             x:Class="AirsoftPlanner.App.Views.MissionsView"
             x:DataType="vm:MissionsViewModel">
    <Grid ColumnDefinitions="*,360">
        <DockPanel>
            <Border DockPanel.Dock="Top" Padding="10,6" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="+ Mission" Command="{Binding AddCommand}" />
                        <Button Content="Dupliquer" Command="{Binding DuplicateCommand}" />
                        <Button Content="Supprimer" Command="{Binding RemoveCommand}" />
                        <Button Content="Tout afficher" Click="OnFitClick" />
                    </StackPanel>
                    <TextBlock Text="{Binding IssueSummary}" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                </DockPanel>
            </Border>
            <TextBlock DockPanel.Dock="Bottom" Margin="10,4" FontSize="11" Opacity="0.65" TextWrapping="Wrap"
                       Text="Double-clic : nouvelle mission · Glisser : déplacer (ou changer d'équipe) · Bord bas : durée · Molette : défiler · Ctrl+molette : zoom · Pointillés : mission optionnelle" />
            <controls:TimelineControl x:Name="Timeline"
                                      Columns="{Binding Columns}"
                                      Missions="{Binding Missions}"
                                      SelectedMission="{Binding Selected}"
                                      OperationStart="{Binding OperationStartMinutes}"
                                      OperationEnd="{Binding OperationEndMinutes}"
                                      Day="{Binding Operation.Day}"
                                      CreateCommand="{Binding CreateAtCommand}" />
        </DockPanel>

        <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <Panel>
                <TextBlock IsVisible="{Binding !HasSelection}" Margin="16" TextWrapping="Wrap" Opacity="0.7"
                           Text="Sélectionnez une mission sur la frise, ou double-cliquez dans la colonne d'une équipe pour en créer une." />
                <ScrollViewer IsVisible="{Binding HasSelection}">
                    <StackPanel Margin="14" Spacing="8">
                        <TextBlock Text="Mission" Classes="h1" />
                        <Border IsVisible="{Binding Selected.HasIssues, FallbackValue=False}" Background="#FFEBEE"
                                CornerRadius="4" Padding="8">
                            <TextBlock Text="{Binding Selected.IssuesText, FallbackValue=''}" Foreground="#B71C1C"
                                       TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Text="Nom" Classes="label" />
                        <TextBox Text="{Binding Selected.Name, FallbackValue=''}" />

                        <Grid ColumnDefinitions="*,12,*">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Début" Classes="label" />
                                <TextBox Text="{Binding Selected.StartText, FallbackValue=''}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="10">
                                <TextBlock Text="Durée (min)" Classes="label" />
                                <NumericUpDown Value="{Binding Selected.DurationMinutes, FallbackValue=30}" Minimum="5"
                                               Maximum="1440" Increment="5" FormatString="0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding Selected.TimeRangeText, FallbackValue=''}" FontSize="12" Opacity="0.7" />

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox Content="Essentielle" IsChecked="{Binding Selected.IsEssential, FallbackValue=True}"
                                      ToolTip.Tip="Une mission non essentielle peut être désactivée pour rattraper un retard" />
                            <CheckBox Content="Activée" IsChecked="{Binding Selected.IsEnabled, FallbackValue=True}" />
                        </StackPanel>

                        <TextBlock Text="Zone" Classes="label" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox ItemsSource="{Binding Zones}" SelectedItem="{Binding Selected.Zone, FallbackValue={x:Null}}"
                                      PlaceholderText="Aucune zone" MinWidth="230">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ZoneViewModel">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Width="14" Height="14" CornerRadius="3"
                                                    Background="{Binding Color, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                                            <TextBlock Text="{Binding Name}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="Retirer" Command="{Binding ClearZoneCommand}" />
                        </StackPanel>

                        <TextBlock Text="Équipes" Classes="label" />
                        <ItemsControl ItemsSource="{Binding TeamChoices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TeamChoiceViewModel">
                                    <CheckBox IsChecked="{Binding IsSelected}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Width="10" Height="10" CornerRadius="5"
                                                    Background="{Binding Team.Faction.Color, FallbackValue={x:Null}, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                                            <TextBlock Text="{Binding Team.Name}" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding Selected.PlayersText, FallbackValue=''}" FontSize="12" Opacity="0.75" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <CheckBox Content="Effectif maximum" IsChecked="{Binding Selected.HasMaxPlayers, FallbackValue=False}" />
                            <NumericUpDown Value="{Binding Selected.MaxPlayers, FallbackValue={x:Null}}" Minimum="1" Maximum="5000"
                                           Increment="1" FormatString="0" Width="130"
                                           IsEnabled="{Binding Selected.HasMaxPlayers, FallbackValue=False}" />
                        </StackPanel>

                        <TextBlock Text="Matériel de jeu utilisé" Classes="label" />
                        <ItemsControl ItemsSource="{Binding Selected.ItemUses, FallbackValue={x:Null}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MissionItemUseViewModel">
                                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                                        <TextBlock Text="{Binding Item.Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <NumericUpDown Grid.Column="1" Value="{Binding Quantity}" Minimum="1" Maximum="1000"
                                                       Increment="1" FormatString="0" Width="110" Margin="6,0" />
                                        <Button Grid.Column="2" Content="✕" ToolTip.Tip="Retirer de la mission"
                                                Command="{Binding $parent[UserControl].((vm:MissionsViewModel)DataContext).RemoveItemCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <ComboBox ItemsSource="{Binding GameItems}" SelectedItem="{Binding ItemToAdd}"
                                      PlaceholderText="Choisir un élément…" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GameItemViewModel">
                                        <TextBlock>
                                            <Run Text="{Binding Name}" />
                                            <Run Text="{Binding Quantity, StringFormat='(stock {0})'}" FontSize="11" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <NumericUpDown Grid.Column="1" Value="{Binding ItemToAddQuantity}" Minimum="1" Maximum="1000"
                                           Increment="1" FormatString="0" Width="110" Margin="6,0" />
                            <Button Grid.Column="2" Content="Ajouter" Command="{Binding AddItemCommand}" />
                        </Grid>

                        <TextBlock Text="Prérequis (missions à terminer avant)" Classes="label" />
                        <TextBlock IsVisible="{Binding !PredecessorChoices.Count}" Text="Aucune autre mission." FontSize="12" Opacity="0.6" />
                        <ItemsControl ItemsSource="{Binding PredecessorChoices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PredecessorChoiceViewModel">
                                    <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}">
                                        <TextBlock>
                                            <Run Text="{Binding Mission.StartText}" FontWeight="SemiBold" />
                                            <Run Text="{Binding Mission.Name}" />
                                        </TextBlock>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Briefing (objectif, consignes, conditions de réussite)" Classes="label" />
                        <TextBox Text="{Binding Selected.Description, FallbackValue=''}" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="140" />
                    </StackPanel>
                </ScrollViewer>
            </Panel>
        </Border>
    </Grid>
</UserControl>
