<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.tepangames.airsoftplanner</ApplicationId>
    <ApplicationTitle>Airsoft Planner</ApplicationTitle>
    <ApplicationVersion>4</ApplicationVersion>
    <ApplicationDisplayVersion>0.9.3</ApplicationDisplayVersion>
    <!-- Sérialisation JSON par générateur de source : compatible avec l'élagage du code. -->
    <TrimMode>partial</TrimMode>
    <!-- APK unique, installable directement (sans Play Store). -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- SDK Android et JDK installés dans le profil (dotnet build -t:InstallAndroidDependencies) : trouvés sans paramètre. -->
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and Exists('$(LOCALAPPDATA)\Android\Sdk')">$(LOCALAPPDATA)\Android\Sdk</AndroidSdkDirectory>
    <JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' and Exists('$(LOCALAPPDATA)\Android\jdk')">$(LOCALAPPDATA)\Android\jdk</JavaSdkDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- Messages échangés avec le PC de l'OP : mêmes définitions que le serveur. -->
    <ProjectReference Include="..\AirsoftPlanner.Core\AirsoftPlanner.Core.csproj" />
  </ItemGroup>
</Project>
